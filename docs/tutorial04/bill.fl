# data file for fldtk fluid (Fast Light User Interface Designer)
version 1.0000
dub_header 1
Function calculate()
  {
  }
  {
    code {writeln("calculating..."); // check when called

// calculate the total plus tip
double total = bill.value * (1.0 + tip.value / 100.0);

// now write the calculated amount to the value output widgets
totalwithtip.value = total;
costperperson.value(total / people.value);
}
      {
      }
  }
Function {}
  {
  }
  {
    Window {}
      {
        xywh {480 228 480 320}
      }
      {
        Box {}
          {
            label {Shared bill calculator}
            xywh {15 4 450 36}
            box FLAT_BOX
            labelsize 34
          }
        Input {}
          {
            label {Restaurant}
            xywh {127 56 340 22}
          }
        Spinner people
          {
            label {People}
            callback {calculate();}
            xywh {127 78 64 22}
            value {2}
            when 5
          }
        ValueInput bill
          {
            label {Bill total}
            callback {calculate();}
            xywh {127 100 64 22}
            step {0.01}
            when 5
            setup {bill.maximum(double.infinity);}
          }
        ValueSlider tip
          {
            label {Tip (%)}
            callback {calculate();}
            xywh {127 122 200 22}
            value {20}
            minimum {15}
            maximum {25}
            step {0.1}
            align 4
            when 5
            type Horizontal
            selected
          }
        ValueOutput totalwithtip
          {
            label {Total + tip}
            xywh {127 207 64 22}
            step {0.01}
          }
        ValueOutput costperperson
          {
            label {Cost per person}
            xywh {127 229 64 22}
            step {0.01}
          }
      }
  }
