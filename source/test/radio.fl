# data file for fldtk fluid (Fast Light User Interface Designer)
version 1.0000
Function {buttonCB(Button b)}
  {
    comment {Buttons test callback}
    return_type void
    private
    open
  }
  {
    code {string msg;
  msg = format("Label: '%s'\\nValue: %s\\nChanged: %s",
        b.label(), b.value(), b.changed());
cbInfo.value(msg);
cbInfo.redraw();
writeln(msg);}
      {
        selected
      }
  }
Function {}
  {
    open
  }
  {
    Window {}
      {
        xywh {470 366 369 214}
        type Double
        open
      }
      {
        Button {}
          {
            label {Button &A1}
            xywh {20 10 160 30}
            labelsize 13
            setup {o.callback(buttonCB);}
            tooltip {Normal button (callback called only when released)}
          }
        Button {}
          {
            label {Button &A2}
            xywh {20 44 160 30}
            labelsize 13
            when 1
            setup {o.callback(buttonCB);}
            tooltip {Normal button with callback called when changed (push and released)}
          }
        ReturnButton {}
          {
