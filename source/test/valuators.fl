# data file for fldtk fluid (Fast Light User Interface Designer)
version 1.0000
Function {}
  {
    open
  }
  {
    Window {}
      {
        label {Valuator classes, showing values for type()}
        comment {The plain "0" labels below aren't placeholders -- FL_VERTICAL,
FL_NORMAL_COUNTER, and normalDial are all defined as 0, so the widget in
each group with no type() set displays its own type() value directly.
Every other widget in a group is labeled with the symbolic name of the
non-default type() it demonstrates instead, since a bare number wouldn't
mean anything on its own.}
        xywh {454 295 620 640}
        color 43
        selection_color 43
        type Double
        open
      }
      {
        Group {}
          {
            label {Slider}
            xywh {10 10 320 210}
            box ENGRAVED_BOX
            labelfont 1
            align 17
            open
          }
          {
            Slider {}
              {
                label {0}
                xywh {30 70 20 140}
                selection_color 1
                labelsize 8
                v_label_margin 2
                align 1
                setup {o.callback(valCb("Slider vertSlider"));}
                tooltip {Vertical Slider}
