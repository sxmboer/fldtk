  }
Function {valCb(string name)}
  {
    return_type {void delegate(Widget)}
    open
  }
  {
    code {return (o)
    \{
      auto v = cast(Valuator) o;
      tty.printf("callback(): %s value() = \\033[1m%g\\033[0m\\n", name, v.value());
    \};}
      {
      }
  }
Function {spinnerCb(string name)}
  {
    comment {Spinner doesn't derive from Fl_Valuator..}
    return_type {void delegate(Widget)}
  }
  {
    code {return (o)
    \{
      auto s = cast(Spinner) o;
      tty.printf("callback(): %s value() = \\033[1m%g\\033[0m\\n", name, s.value());
    \};}
      {
      }
  }
