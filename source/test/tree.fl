                  }
                Choice whenmodeChooser
                  {
                    label {When}
                    callback {// Set when mode
switch (whenmodeChooser.value())
  \{
  case 0:  tree.when(whenRelease);   break;
  case 1:  tree.when(whenChanged);   break;
  case 2:  tree.when(whenNever);     break;
  default: tree.when(whenRelease);   break;
  \}}
                    xywh {520 319 140 21}
                    down_box BORDER_BOX
                    labelsize 12
                    textsize 11
                    setup {whenmodeChooser.value(1);
whenmodeChooser.doCallback();}
                    tooltip {Sets when() the tree's callback is invoked}
                  }
                  {
                    MenuItem {}
                      {
                        label {Changed}
                      }
