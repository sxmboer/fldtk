                Button swapselectedButton
                  {
                    label {Swap Selected}
                    callback {TreeItem a, b;
for (auto item = tree.first(); item !is null; item = item.next())
  \{
    if (item.isSelected())
      \{
        if (a is null) a = item;
        else if (b is null) b = item;
        else
          \{
            alert("Too many items selected. (must select only two)");
            return;
          \}
      \}
  \}
if (a is null || b is null)
  \{
    alert("Too few items selected. (you must select two)");
    return;
  \}
auto pa = a.parent();
auto pb = b.parent();
if (pa !is pb)
  \{
    alert("The two selected items must be siblings");
    return;
  \}
pa.swapChildren(a, b);
tree.redraw();}
                    xywh {864 174 95 16}
                    labelsize 9
                    tooltip {Tests the TreeItem.swap_children() method
Swaps two selected items (items must be siblings)}
