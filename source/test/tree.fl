                Button testcallbackflagButton
                  {
                    label {Test Callback Flag}
                    callback {auto root = tree.root();
tty.printf("--- Checking docallback off\\n");
if (root is null) return;

//// "OFF" TEST

// open/close: Make sure these methods don't trigger cb
gCbCounter = 0; tree.close(root, false);      if (gCbCounter) alert("FAILED 'OFF' TEST\\n close(item) triggered cb!");
gCbCounter = 0; tree.open(root, false);       if (gCbCounter) alert("FAILED 'OFF' TEST\\n open(item) triggered cb!");
gCbCounter = 0; tree.openToggle(root, false); if (gCbCounter) alert("FAILED 'OFF' TEST\\n open_toggle(item) triggered cb!");
gCbCounter = 0; tree.open("ROOT", false);     if (gCbCounter) alert("FAILED 'OFF' TEST\\n open(path) triggered cb!");
gCbCounter = 0; tree.close("ROOT", false);    if (gCbCounter) alert("FAILED 'OFF' TEST\\n close(path) triggered cb!");
tree.open(root, false);     // leave root open

// select/deselect: Make sure these methods don't trigger cb
gCbCounter = 0; tree.select(root, false);       if (gCbCounter) alert("FAILED 'OFF' TEST\\n select(item) triggered cb!");
gCbCounter = 0; tree.deselect(root, false);     if (gCbCounter) alert("FAILED 'OFF' TEST\\n deselect(item) triggered cb!");
gCbCounter = 0; tree.selectToggle(root, false); if (gCbCounter) alert("FAILED 'OFF' TEST\\n select_toggle(item) triggered cb!");
gCbCounter = 0; tree.deselect("ROOT", false);   if (gCbCounter) alert("FAILED 'OFF' TEST\\n deselect(path) triggered cb!");
gCbCounter = 0; tree.select("ROOT", false);     if (gCbCounter) alert("FAILED 'OFF' TEST\\n select(path) triggered cb!");
tree.deselect("ROOT"); // leave deselected

//// "ON" TEST

// open/close: Make sure these methods don't trigger cb
gCbCounter = 0; tree.close(root, true);      if (!gCbCounter) alert("FAILED 'ON' TEST\\n close(item) cb wasn't triggered!");
gCbCounter = 0; tree.open(root, true);       if (!gCbCounter) alert("FAILED 'ON' TEST\\n open(item) cb wasn't triggered!");
gCbCounter = 0; tree.openToggle(root, true); if (!gCbCounter) alert("FAILED 'ON' TEST\\n open_toggle(item) cb wasn't triggered!");
gCbCounter = 0; tree.open(root, true);       if (!gCbCounter) alert("FAILED 'ON' TEST\\n open(item)[2] cb wasn't triggered!");
gCbCounter = 0; tree.close(root, true);      if (!gCbCounter) alert("FAILED 'ON' TEST\\n close(item)[2] cb wasn't triggered!");
gCbCounter = 0; tree.open("ROOT", true);     if (!gCbCounter) alert("FAILED 'ON' TEST\\n open(path) cb wasn't triggered!");
gCbCounter = 0; tree.close("ROOT", true);    if (!gCbCounter) alert("FAILED 'ON' TEST\\n close(path) cb wasn't triggered!");
tree.open(root, false);     // leave root open

// select/deselect: Make sure these methods don't trigger cb
gCbCounter = 0; tree.select(root, true);       if (!gCbCounter) alert("FAILED 'ON' TEST\\n select(item) cb wasn't triggered!");
gCbCounter = 0; tree.deselect(root, true);     if (!gCbCounter) alert("FAILED 'ON' TEST\\n deselect(item) cb wasn't triggered!");
gCbCounter = 0; tree.selectToggle(root, true); if (!gCbCounter) alert("FAILED 'ON' TEST\\n select_toggle(item) cb wasn't triggered!");
gCbCounter = 0; tree.deselect("ROOT", true);   if (!gCbCounter) alert("FAILED 'ON' TEST\\n deselect(path) cb wasn't triggered!");
gCbCounter = 0; tree.select("ROOT", true);     if (!gCbCounter) alert("FAILED 'ON' TEST\\n select(path) cb wasn't triggered!");
tree.deselect("ROOT"); // leave deselected

//// "default" TEST (should be same as 'on'

// open/close: Make sure these methods don't trigger cb
gCbCounter = 0; tree.close(root);      if (!gCbCounter) alert("FAILED 'DEFAULT' TEST: close(item) cb wasn't triggered!");
gCbCounter = 0; tree.open(root);       if (!gCbCounter) alert("FAILED 'DEFAULT' TEST: open(item) cb wasn't triggered!");
gCbCounter = 0; tree.openToggle(root); if (!gCbCounter) alert("FAILED 'DEFAULT' TEST: open_toggle(item) cb wasn't triggered!");
gCbCounter = 0; tree.open("ROOT");     if (!gCbCounter) alert("FAILED 'DEFAULT' TEST: open(path) cb wasn't triggered!");
gCbCounter = 0; tree.close("ROOT");    if (!gCbCounter) alert("FAILED 'DEFAULT' TEST: close(path) cb wasn't triggered!");
tree.open(root, false);     // leave root open

// select/deselect: Make sure these methods don't trigger cb
gCbCounter = 0; tree.select(root);       if (!gCbCounter) alert("FAILED 'DEFAULT' TEST\\n select(item) cb wasn't triggered!");
gCbCounter = 0; tree.deselect(root);     if (!gCbCounter) alert("FAILED 'DEFAULT' TEST\\n deselect(item) cb wasn't triggered!");
gCbCounter = 0; tree.selectToggle(root); if (!gCbCounter) alert("FAILED 'DEFAULT' TEST\\n select_toggle(item) cb wasn't triggered!");
gCbCounter = 0; tree.deselect("ROOT");   if (!gCbCounter) alert("FAILED 'DEFAULT' TEST\\n deselect(path) cb wasn't triggered!");
gCbCounter = 0; tree.select("ROOT");     if (!gCbCounter) alert("FAILED 'DEFAULT' TEST\\n select(path) cb wasn't triggered!");
tree.deselect("ROOT"); // leave deselected

alert("TEST COMPLETED\\n If you didn't see any error dialogs, test PASSED.");}
