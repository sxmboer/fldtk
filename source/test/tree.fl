                CheckButton showrootRadio
                  {
                    label {Show root?}
                    callback {bool onoff = showrootRadio.value();
tree.showroot(onoff);}
                    xywh {485 368 20 16}
                    down_box DOWN_BOX
                    labelsize 11
                    align 7
                    setup {showrootRadio.value(tree.showroot());}
                    tooltip {Tests tree.showroot();}
                  }
                CheckButton visiblefocusCheckbox
                  {
                    label {Visible focus?}
                    callback {bool onoff = visiblefocusCheckbox.value();
tree.visibleFocus(onoff);}
                    xywh {485 385 20 16}
                    down_box DOWN_BOX
                    labelsize 11
                    align 7
                    setup {visiblefocusCheckbox.value(tree.visibleFocus());}
                    tooltip {Toggles the tree's visible_focus() box}
                  }
                CheckButton labelandwidgetRadio
                  {
                    label {Show label + widget}
                    callback {auto flags = tree.itemDrawMode();
if (labelandwidgetRadio.value())
  flags |= itemDrawLabelAndWidget;
else
  flags &= ~itemDrawLabelAndWidget;
tree.itemDrawMode(flags);
tree.redraw();}
                    xywh {645 351 20 16}
                    down_box DOWN_BOX
                    labelsize 11
                    align 7
                    setup {labelandwidgetRadio.value(false);
labelandwidgetRadio.doCallback();}
                    tooltip {Tests Tree.itemDrawMode(itemDrawLabelAndWidget)
Enables both label and widget() for display.
When enabled, widget should appear to the right of the item's label.
By default, the widget() is shown in place of the item's label.}
                  }
                CheckButton itemheightfromwidgetRadio
                  {
                    label {Item h() from widget}
                    callback {auto flags = tree.itemDrawMode();
if (itemheightfromwidgetRadio.value())
  flags |= itemHeightFromWidget;
else
  flags &= ~itemHeightFromWidget;
tree.itemDrawMode(flags);
tree.redraw();}
                    xywh {645 368 20 16}
                    down_box DOWN_BOX
                    labelsize 11
                    align 7
                    setup {itemheightfromwidgetRadio.value(false);
itemheightfromwidgetRadio.doCallback();}
                    tooltip {Tests Tree.itemDrawMode(itemHeightFromWidget)
If enabled, item's height will track the widget()'s height.
