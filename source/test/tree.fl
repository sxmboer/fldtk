                Button add20kButton
                  {
                    label {Add 20,000}
                    callback {static int itemId = 501;
auto item = tree.first();
while (item !is null)
  \{
    if (item.isSelected())
      \{
        auto parent = item.parent();
        if (parent is null) parent = tree.root();
        foreach (i; 0 .. 20000)
          tree.add(parent, format("Item \#%d", itemId + i));
        itemId += 20000;
        break;
      \}
    item = item.next();
  \}
tree.redraw();}
                    xywh {570 531 95 16}
                    labelsize 9
                    tooltip {Adds 20,000 items to the selected item's parent}
                  }
