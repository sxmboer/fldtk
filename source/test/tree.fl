                Button labelcolorButton
                  {
                    label {labelcolor()}
                    callback {Color val = tree.labelcolor();
if (editColor(val) == 0) return;                        // Let user edit color. (return if they hit 'Cancel')
labelcolorButton.color(val);                            // update modified color to button
tree.labelcolor(val);
window.redraw();   // affects window (tree's label is outside tree's area)
labelcolorButton.redraw();   // this button's own release-triggered redraw fired
                             // (and got processed) while editColor()'s modal dialog's
                             // own nested event loop was still running, painting the
                             // *old* color -- window.redraw() above doesn't help since
                             // it's scheduled *after* this point, but the widget-level
                             // damage it sets doesn't retroactively force this specific
                             // button to redraw either; an explicit self-redraw here is
                             // the reliable fix (see colorButton's own doc comment for
                             // the full mechanism).}
                    xywh {813 414 16 16}
                    box DOWN_BOX
                    labelsize 11
                    align 7
                    setup {o.color(tree.labelcolor());}
                    tooltip {Changes Tree.labelcolor().
This affects the text color of the widget's label.}
                  }
                Button colorButton
                  {
                    label {color()}
                    callback {Color val = tree.color();
if (editColor(val) == 0) return;                        // Let user edit color. (return if they hit 'Cancel')
colorButton.color(val);         // update modified color to button
tree.color(val);
updateColorChips();
tree.redraw();
// Explicit self-redraw needed on Windows: this button's own normal
// FL_RELEASE-triggered redraw (the "back to up" visual state every
// FLTK button does on release) gets queued via InvalidateRect() the
// moment this button is clicked -- but editColor()'s modal color-
// chooser dialog then runs its own *nested* event loop
// (while (window.shown()) fl.core.wait();) that pumps *all* pending
// Windows messages, including that queued repaint -- so it gets
// processed, and this button gets painted with its *old*
// color, before this callback ever resumes past editColor() to set
// the new one. tree.redraw() above doesn't retroactively fix this --
// it damages the tree's own bounds, not this sibling button's -- so
// nothing repaints this button again afterward until some unrelated
// later damage (e.g. hovering it) happens to cover its rectangle too.
// An explicit redraw here, *after* the color actually changes, closes
// that gap for real regardless of the nested-loop timing.
colorButton.redraw();}
                    xywh {813 433 16 16}
                    box DOWN_BOX
                    labelsize 11
                    align 7
                    setup {o.color(tree.color());}
                    tooltip {Changes Tree.color().
This affects the background color of the widget. It also affects the bg color of newly created  items *if*  Tree.itemLabelbgcolor() hasn't been changed.}
                  }
                Button selectionColorButton
                  {
                    label {selection_color()}
                    callback {Color val = tree.selectionColor();
if (editColor(val) == 0) return;                // Let user edit color. (return if they hit 'Cancel')
selectionColorButton.color(val);                // update modified color to button
tree.selectionColor(val);
tree.redraw();
selectionColorButton.redraw();   // see colorButton's own doc comment for why}
                    xywh {813 452 16 16}
                    box DOWN_BOX
                    labelsize 11
                    align 7
                    setup {o.color(tree.selectionColor());}
                    tooltip {Sets the Tree.selectionColor().
This affects the item's colors when they're selected.}
                  }
                Button itemLabelfgcolorButton
                  {
                    label {item_labelfgcolor()}
                    callback {Color val = tree.itemLabelfgcolor();
if (editColor(val) == 0) return;                // Let user edit color. (return if they hit 'Cancel')
tree.itemLabelfgcolor(val);                     // apply modified color to tree
itemLabelfgcolorButton.color(val);              // update modified color to button
tree.redraw();
itemLabelfgcolorButton.redraw();   // see colorButton's own doc comment for why}
                    xywh {973 414 16 16}
                    box DOWN_BOX
                    labelsize 12
                    align 7
                    setup {o.color(tree.itemLabelfgcolor());}
                    tooltip {Sets the default label fg color for newly created  items.}
                  }
                Button itemLabelbgcolorButton
                  {
                    label {item_labelbgcolor()}
                    callback {Color val = tree.itemLabelbgcolor();
if (editColor(val) == 0) return;                // Let user edit color. (return if they hit 'Cancel')
tree.itemLabelbgcolor(val);                     // apply modified color to tree
itemLabelbgcolorButton.color(val);              // update modified color to button
tree.redraw();
itemLabelbgcolorButton.redraw();   // see colorButton's own doc comment for why}
                    xywh {973 433 16 16}
                    box DOWN_BOX
                    labelsize 12
                    align 7
                    setup {itemLabelbgcolorButton.color(tree.itemLabelbgcolor());}
                    tooltip {Sets the default label bg color for newly created items. When set, this overrides the default behavior of using Tree.color().}
                  }
                Button xItemLabelbgcolorButton
                  {
                    label {X}
                    callback {tree.itemLabelbgcolor(cast(Color) 0xffffffff);
updateColorChips();
tree.redraw();}
                    xywh {993 433 16 16}
                    labelsize 10
                    align 16
                    tooltip {Make the bgcolor 'transparent' (0xffffffff)}
                  }
