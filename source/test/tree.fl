# data file for fldtk fluid (Fast Light User Interface Designer)
version 1.0000
decl {int gCbCounter = 0;}
  {
    comment {Global callback event counter}
    private
    local
  }
Function {reasonAsName(CallbackReason reason)}
  {
    comment {Return a CallbackReason as a text string name}
    return_type string
  }
  {
    code {switch (reason)
  \{
  case CallbackReason.unknown:      return "none";
  case CallbackReason.selected:     return "selected";
  case CallbackReason.deselected:   return "deselected";
  case CallbackReason.opened:       return "opened";
  case CallbackReason.closed:       return "closed";
  case CallbackReason.dragged:      return "dragged";
  case CallbackReason.reselected:   return "reselected";
  default:                          return "???";
  \}}
      {
      }
  }
Function {buttonCB(Widget w)}
  {
    comment {Each push changes height so we can test 'Item h() from widget'.
Cycle through larger sizes until 50, then wrap to normal size.

In the case of 'ccc button', it is the child widget, so change
its size.

In the case of the 'D1' and 'D2' buttons, the parent's Group
is the child, so change the size of that instead.}
    return_type void
    open
  }
  {
    code {Widget cw = w.label() == "ccc button" ? w : w.parent();
int height = cw.h();
height += 10;
if (height > 50) height = 20;
cw.resize(cw.x(), cw.y(), cw.w(), height);
tree.redraw(); // adjusted height
tty.printf("'%s' button pushed (height=%d)\\n", w.label(), height);}
      {
      }
  }
Function assignUserIcons()
  {
    comment {Assign user icons to the items}
    open
  }
  {
    code {static immutable string[] folderXpm = [
  "11 11 3 1",
  ".  c None",
  "x  c \#d8d833",
  "@  c \#808011",
  "...........",
  ".....@@@@..",
  "....@xxxx@.",
  "@@@@@xxxx@@",
  "@xxxxxxxxx@",
  "@xxxxxxxxx@",
  "@xxxxxxxxx@",
  "@xxxxxxxxx@",
  "@xxxxxxxxx@",
  "@xxxxxxxxx@",
  "@@@@@@@@@@@",
];
static immutable string[] documentXpm = [
  "11 11 3 1",
  ".  c None",
  "x  c \#d8d8f8",
  "@  c \#202060",
  ".@@@@@@@@@.",
  ".@xxxxxxx@.",
  ".@xxxxxxx@.",
  ".@xxxxxxx@.",
  ".@xxxxxxx@.",
  ".@xxxxxxx@.",
  ".@xxxxxxx@.",
  ".@xxxxxxx@.",
  ".@xxxxxxx@.",
  ".@xxxxxxx@.",
  ".@@@@@@@@@.",
];
static Pixmap folderPixmap;
static Pixmap documentPixmap;
static Pixmap folderDeiconPixmap;
static Pixmap documentDeiconPixmap;
static bool first = true;
if (first)
  \{
    folderPixmap = new Pixmap(folderXpm);
    documentPixmap = new Pixmap(documentXpm);
    folderDeiconPixmap = new Pixmap(folderXpm);
    documentDeiconPixmap = new Pixmap(documentXpm);
    folderDeiconPixmap.inactive();
    documentDeiconPixmap.inactive();
    first = false;
  \}

// Assign user icons to tree items
for (auto item = tree.first(); item !is null; item = item.next())
  \{
    if (usericonRadio.value())
      \{
        // Assign custom icons
        if (item.hasChildren())
          \{
            item.usericon(folderPixmap);
            item.userdeicon(folderDeiconPixmap);
          \}
        else
          \{
            item.usericon(documentPixmap);
            item.userdeicon(documentDeiconPixmap);
          \}
      \}
    else
      \{
        // Don't assign custom icons
        item.usericon(null);
        item.userdeicon(null);
      \}
  \}
tree.redraw();}
      {
      }
  }
Function rebuildTree()
  {
    comment {Rebuild the 'example tree' from scratch}
    open
  }
  {
    code {// REBUILD THE TREE TO MAKE CURRENT "DEFAULT" PREFS TAKE EFFECT
tree.clear();
tree.add("Aaa");
tree.add("Bbb");
tree.add("Ccc");
tree.add("Ddd");
tree.add("Bbb/child-01");
tree.add("Bbb/child-01/111");
tree.add("Bbb/child-01/222");
tree.add("Bbb/child-01/333");
tree.add("Bbb/child-02");
tree.add("Bbb/child-03");
tree.add("Bbb/child-04");

\{
  static Input bbbInput;
  // Assign an FLTK input widget to one of the items with a label() of its own (STR\#2832)
  auto item = tree.findItem("Bbb/child-02");
  if (item !is null)
    \{
      if (bbbInput is null)
        \{          // only do this once at program startup
          tree.begin();
          bbbInput = new Input(1, 1, 100, 1, "Input test");       // we control w() only
          bbbInput.labelsize(10);
          bbbInput.textsize(10);
          bbbInput.alignment(alignRight);                        // show label to the right of the widget
          bbbInput.tooltip("Input inside tree.\\n" ~
              "The widget's label 'Input test' should appear to the widget's right.");
        \}
      bbbInput.show();
      item.widget(bbbInput);
      tree.end();
    \}
\}

\{
  static Button bbbButton;
  // Assign an FLTK widget to one of the items
  auto item = tree.findItem("Bbb/child-03");
  if (item !is null)
    \{
      if (bbbButton is null)
        \{           // only do this once at program startup
          tree.begin();
          bbbButton = new Button(1, 1, 140, 1, "ccc button");     // we control w() only
          bbbButton.labelsize(10);
          bbbButton.callback(buttonCB);
          bbbButton.tooltip("Button inside tree.\\n" ~
              "If 'Item h() from widget' enabled, " ~
              "pressing button enlarges it.");
        \}
      bbbButton.show();
      item.widget(bbbButton);
      tree.end();
    \}
\}
\{
  // Assign an FLTK group to one of the items with widgets
  string tipmsg = "A group of two buttons inside the tree.\\n" ~
      "If 'Item h() from widget' enabled, " ~
      "pressing either button enlarges the group " ~
      "and both buttons together.";
  auto item = tree.findItem("Bbb/child-04");
  if (item !is null)
    \{
      static FlGroup bbbGroup;
      if (bbbGroup is null)
        \{           // only do this once at program startup
          tree.begin();
          bbbGroup = new FlGroup(100, 100, 140, 18); // build group.. tree handles position
          bbbGroup.color(white);
          bbbGroup.begin();
          auto abut = new Button(bbbGroup.x() + 0, bbbGroup.y() + 2, 65, 15, "D1");
          abut.labelsize(10);
          abut.callback(buttonCB);
          abut.tooltip(tipmsg);
          auto bbut = new Button(bbbGroup.x() + 75, bbbGroup.y() + 2, 65, 15, "D2");
          bbut.labelsize(10);
          bbut.callback(buttonCB);
          bbut.tooltip(tipmsg);

          bbbGroup.end();
          bbbGroup.resizable(bbbGroup);
          tree.end();
        \}
      bbbGroup.show();
      item.widget(bbbGroup);
    \}
\}

// Add an 'Ascending' node, and create it sorted
tree.sortorder(TreeSort.sortNone);
tree.add("Ascending").close();
tree.sortorder(TreeSort.sortAscending);
tree.add("Ascending/Zzz");
tree.add("Ascending/Xxx");
tree.add("Ascending/Aaa");
tree.add("Ascending/Bbb");
tree.add("Ascending/Yyy");
tree.add("Ascending/Ccc");

// Add a 'Descending' node, and create it sorted
tree.sortorder(TreeSort.sortNone);
tree.add("Descending").close();
tree.sortorder(TreeSort.sortDescending);
tree.add("Descending/Zzz");
tree.add("Descending/Xxx");
tree.add("Descending/Aaa");
tree.add("Descending/Bbb");
tree.add("Descending/Yyy");
tree.add("Descending/Ccc");

// Add a long line to trigger horiz scrollbar
tree.sortorder(TreeSort.sortNone);
tree.add("Long Line").close();
tree.add("Long Line/The quick brown fox jumped over the lazy dog. 0123456789");
tree.add("Long Line/Longer Line").close();
tree.add("Long Line/Longer Line/The quick brown fox jumped over the lazy dog. ---------------- 0123456789");

// Add 500 items in numerical order
foreach (t; 0 .. 500)
  tree.add(format("500 Items/item %04d", t + 1));
tree.close("500 Items");       // close the 500 items by default

assignUserIcons();

tree.redraw();
FlGroup.current(null);}
      {
      }
  }
Function {editColor(ref Color val)}
  {
    comment {Prompt the user to change the specified color.
Returns:
    1 if color picked with new color in 'val'
    0 if user hit 'Cancel'.}
    return_type int
  }
  {
    code {ubyte r, g, b;

// Get the current color
fl.core.getColor(val, r, g, b);

// Bring up a color chooser to edit it
int ret = colorChooser("Choose Color", r, g, b);

val = rgbColor(r, g, b);

return ret;}
      {
      }
  }
Function updateColorChips()
  {
    comment {Updates the color chips with current colors from widget}
    return_type void
    open
  }
  {
    code {colorButton.color(tree.color());
labelcolorButton.color(tree.labelcolor());
selectionColorButton.color(tree.selectionColor());

itemLabelfgcolorButton.color(tree.itemLabelfgcolor());
itemLabelbgcolorButton.color(tree.itemLabelbgcolor());

allLabelfgcolorButton.color(tree.itemLabelfgcolor());  // use default
allLabelbgcolorButton.color(tree.itemLabelbgcolor());  // use default

window.redraw();}
      {
      }
  }
Function getTreeMarginBottom()
  {
    comment {Get the current 'margin bottom' size.
Handles this as an ABI feature..}
    return_type int
    open
  }
  {
    code {return tree.marginbottom();}
      {
      }
  }
Function getTreeWidgetMarginLeft()
  {
    comment {Get the current 'margin bottom' size.
Handles this as an ABI feature..}
    return_type int
    open
  }
  {
    code {return tree.widgetmarginleft();}
      {
      }
  }
Function getSelectedItemFGColor()
  {
    comment {Return the selected item's fg color}
    return_type Color
    open
  }
  {
    code {for (auto item = tree.first(); item !is null; item = tree.next(item))
  \{
    if (item.isSelected())
      return item.labelfgcolor();
  \}
// No items selected? Use default
return tree.itemLabelfgcolor();}
      {
      }
  }
Function getSelectedItemBGColor()
  {
    comment {Return the selected item's bg color}
    return_type Color
    open
  }
  {
    code {for (auto item = tree.first(); item !is null; item = tree.next(item))
  \{
    if (item.isSelected())
      return item.labelbgcolor();
  \}
// No items selected? Use default
return tree.itemLabelbgcolor();}
      {
      }
  }
Function {}
  {
    open
  }
  {
    Window window
      {
        label {tree}
        xywh {456 262 1045 730}
        type Double
      }
      {
        Group tree
          {
            label {Tree}
            callback {gCbCounter++; // Increment callback counter whenever tree callback is invoked
auto item = tree.callbackItem();
if (item !is null)
  \{
    tty.printf("TREE CALLBACK: label='%s' reason=%s, changed=%d",
        item.label(),
        reasonAsName(tree.callbackReason()),
        tree.changed() ? 1 : 0);
    // More than one click? show click count
    //    Should only happen if reason==reselected.
    //
    if (fl.core.eventClicks() > 0)
      tty.printf(", clicks=%d\\n", fl.core.eventClicks() + 1);
    else
      tty.printf("\\n");
  \}
else
  \{
    tty.printf("TREE CALLBACK: reason=%s, changed=%d, item=(no item -- probably multiple items were changed at once)\\n",
        reasonAsName(tree.callbackReason()),
        tree.changed() ? 1 : 0);
  \}
tree.clearChanged();}
            xywh {15 22 320 539}
            box DOWN_BOX
            color 55
            selection_color 15
            class Tree
            tooltip {Test tree}
          }
          {
          }
        Group {}
          {
            xywh {350 5 681 556}
            setup {o.resizable(null);}
            open
          }
          {
            Group {}
              {
                label {Tree Globals}
                xywh {350 23 330 389}
                box GTK_DOWN_BOX
                color 47
                labelsize 12
                tooltip {These controls only affect the selected items. If no items are selected, all existing items in tree are modified.}
              }
              {
                ValueSlider margintopSlider
                  {
                    label {margintop()}
                    callback {int val = cast(int) margintopSlider.value();
tree.margintop(val);
tree.redraw();}
                    xywh {505 36 155 16}
                    color 46
                    selection_color 1
                    labelsize 10
                    textsize 9
                    align 4
                    type Horizontal
                    setup {o.value(tree.margintop());
o.range(0.0, 100.0);
o.step(1.0);}
                    tooltip {Changes the top margin for the tree widget}
                  }
                ValueSlider marginleftSlider
                  {
                    label {marginleft()}
                    callback {int val = cast(int) marginleftSlider.value();
tree.marginleft(val);
tree.redraw();}
                    xywh {505 56 155 16}
                    color 46
                    selection_color 1
                    labelsize 10
                    textsize 9
                    align 4
                    type Horizontal
                    setup {o.value(tree.marginleft());
o.range(0.0, 200.0);
o.step(1.0);}
                    tooltip {Changes the left margin for the tree widget}
                  }
                ValueSlider marginbottomSlider
                  {
                    label {marginbottom()}
                    callback {int val = cast(int) marginbottomSlider.value();
tree.marginbottom(val);
tree.redraw();}
                    xywh {505 76 155 16}
