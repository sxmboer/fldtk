                ValueSlider openchildMarginbottomSlider
                  {
                    label {openchild_marginbottom()}
                    callback {int val = cast(int) openchildMarginbottomSlider.value();
tree.openchildMarginbottom(val);
tree.redraw();}
                    xywh {505 176 155 16}
                    color 46
                    selection_color 1
                    labelsize 10
                    textsize 9
                    align 4
                    type Horizontal
                    setup {o.value(tree.openchildMarginbottom());
o.range(0.0, 100.0);
o.step(1.0);}
                    tooltip {Changes the vertical space below an open child tree}
                  }
                ValueSlider connectorwidthSlider
                  {
                    label {connectorwidth()}
                    callback {tree.connectorwidth(cast(int) connectorwidthSlider.value());}
                    xywh {505 195 155 16}
                    color 46
                    selection_color 1
                    labelsize 11
                    textsize 9
                    align 4
                    type Horizontal
                    setup {o.value(tree.connectorwidth());
o.range(1.0, 100.0);
o.step(1.0);
o.color(46);
o.selectionColor(red);}
                    tooltip {Tests Tree.connectorwidth()}
                  }
                Choice collapseiconsChooser
                  {
                    label {Collapse icons}
                    callback {static immutable string[] openXpm = [
  "11 11 2 1",
  ".  c None",
  "@  c \#000000",
  "...........",
  "....@......",
  "....@@.....",
  "....@@@....",
  "....@@@@...",
  "....@@@@@..",
  "....@@@@...",
  "....@@@....",
  "....@@.....",
  "....@......",
  "...........",
];
static immutable string[] closeXpm = [
  "11 11 2 1",
  ".  c None",
  "@  c \#000000",
  "...........",
  "...........",
  "...........",
  "...........",
  ".@@@@@@@@@.",
  "..@@@@@@@..",
  "...@@@@@...",
  "....@@@....",
  ".....@.....",
  "...........",
  "...........",
];
static Pixmap openPixmap;
static Pixmap closePixmap;
if (openPixmap is null)
  \{
    openPixmap = new Pixmap(openXpm);
    closePixmap = new Pixmap(closeXpm);
  \}

switch (collapseiconsChooser.value())
  \{
  case 0:
    tree.showcollapse(true);
    tree.openicon(null);
    tree.closeicon(null);
    break;
  case 1:
    tree.showcollapse(true);
    tree.openicon(openPixmap);
    tree.closeicon(closePixmap);
    break;
  case 2:
    tree.showcollapse(false);
    break;
  default:
    break;
  \}}
                    xywh {520 221 140 21}
                    down_box BORDER_BOX
                    labelsize 12
                    textsize 11
                    tooltip {Tests Tree.openicon(), Tree.closeicon() and Tree.showcollapse().}
                  }
                  {
                    MenuItem {}
                      {
                        label {Default}
                      }
                    MenuItem {}
                      {
                        label {Custom}
                      }
                    MenuItem {}
                      {
                        label {Off}
                      }
                  }
                Choice connectorstyleChooser
                  {
                    label {Line style}
                    callback {// CHANGE COLLAPSESTYLE
switch (connectorstyleChooser.value())
  \{
  case 0: tree.connectorstyle(TreeConnector.connectorNone);   break;
  case 1: tree.connectorstyle(TreeConnector.connectorDotted); break;
  case 2: tree.connectorstyle(TreeConnector.connectorSolid);  break;
  default: break;
  \}}
                    xywh {520 245 140 21}
                    down_box BORDER_BOX
                    labelsize 12
                    textsize 11
                    tooltip {Tests Tree.connectorstyle() bit flags}
                  }
                  {
                    MenuItem {}
                      {
                        label {None}
                      }
                    MenuItem {}
                      {
                        label {Dotted}
                      }
                    MenuItem {}
                      {
                        label {Solid}
                      }
                  }
                Choice selectmodeChooser
                  {
                    label {Selection Mode}
                    callback {// Set selection mode
switch (selectmodeChooser.value())
  \{
  case 0:  tree.selectmode(TreeSelect.selectNone);              break;
  case 1:  tree.selectmode(TreeSelect.selectSingle);            break;
  case 2:  tree.selectmode(TreeSelect.selectMulti);             break;
  case 3:  tree.selectmode(TreeSelect.selectSingleDraggable);   break;
  default: tree.selectmode(TreeSelect.selectSingle);            break;
  \}}
                    xywh {520 269 140 21}
                    down_box BORDER_BOX
                    labelsize 12
                    textsize 11
                    setup {selectmodeChooser.value(2);
selectmodeChooser.doCallback();}
                    tooltip {Tests Tree.selectmode()
Sets how Tree handles mouse selection of tree items.
    NONE        -- Not selectable by keyboard/mouse
    SINGLE      -- Only one item at a time selectable by keyboard/mouse
    MULTI       -- Multiple items selectable
    SINGLE+DRAG -- Lets user drag items to different position in tree}
                  }
                  {
                    MenuItem {}
                      {
                        label {None}
                      }
                    MenuItem {}
                      {
                        label {Single}
                      }
                    MenuItem {}
                      {
                        label {Multi}
                      }
                    MenuItem {}
                      {
                        label {Single + drag}
                      }
                  }
                Choice reselectmodeChooser
                  {
                    label {Item Reselect Mode}
                    callback {// Set reselection mode
switch (reselectmodeChooser.value())
  \{
  case 0: tree.itemReselectMode(TreeItemReselectMode.selectableOnce);   break;
  case 1: tree.itemReselectMode(TreeItemReselectMode.selectableAlways); break;
  default: break;
  \}}
                    xywh {520 293 140 21}
                    down_box BORDER_BOX
                    labelsize 12
                    textsize 11
                    setup {reselectmodeChooser.value(1);
reselectmodeChooser.doCallback();}
