Function readLanguagePrefs()
  {
    comment {Read the language setting before we create the UI.}
    return_type void
    open
  }
  {
    code {auto app = new Preferences(rootUserL, project, application);
app.get("language", gLanguage, 0);}
      {
      }
  }
Function readPrefs()
  {
    return_type void
    open
  }
  {
    code {int intValue;
double doubleValue;

string path;
auto root = fl.preferences.preferencesFilename(path, rootUserL, project, application);
if (root == rootUnknown)
    writefln("Location of future Preferences file not found.");
else
    writefln("Preferences file will be located at:\\n%s", path);

auto app = new Preferences(rootUserL, project, application);
root = app.filename(path);
if (root == rootUnknown)
    writefln("Location of app Preferences file not found.");
else if (root == rootMemory)
    writefln("App Preferences are memory mapped.");
else
    writefln("App Preferences file is actually located at:\\n%s", path);

string udPath;
app.getUserdataPath(udPath);
if (udPath.length)
    writefln("Preferences user data directory is located at:\\n%s", udPath);
else
    writefln("Location of Preferences user data directory not found.");

wLanguage.value(gLanguage);

auto bed = new Preferences(app, "Bed");
string alarmBuf;
bed.get("alarm", alarmBuf, "8:00");
wAlarm.value(alarmBuf);

bed.get("ampm", intValue, 0);
wAmPm.value(intValue);

bed.get("wear", intValue, 1);
wWear.value(intValue);

int side;
bed.get("side", side, 2);
if (side == 1) wLeft.value(1);
if (side == 2) wRight.value(1);

int tasks;
bed.get("taskFlags", tasks, 0x05);
if (tasks & 0x01) wShower.value(1);
if (tasks & 0x02) wShave.value(1);
if (tasks & 0x04) wBrush.value(1);

auto eat = new Preferences(app, "Breakfast");

eat.get("drink", intValue, 1);
wDrink.value(intValue);

eat.get("wMilk", intValue, 0);
wMilk.value(intValue != 0);

eat.get("bread", intValue, 0);
wBread.value(intValue);

eat.get("wButter", intValue, 1);
wButter.value(intValue != 0);

eat.get("nEggs", intValue, 2);
wEggs.value(format("%d", intValue));

eat.get("minutes", doubleValue, 3.2);
wMinutes.value(doubleValue);

string paperBuf;
eat.get("newspaper", paperBuf, gettext("NY Times"));
wPaper.value(paperBuf);

string fooBuf;
eat.get("foo", fooBuf, "bar");}
      {
      }
  }
Function writePrefs()
  {
    return_type void
    open
  }
  {
    code {auto app = new Preferences(rootUserL, project, application);

app.set("language", wLanguage.value());

auto bed = new Preferences(app, "Bed");

bed.set("alarm", wAlarm.value());
bed.set("ampm", wAmPm.value());

bed.set("wear", wWear.value());

int side = 0;
if (wLeft.value()) side = 1;
if (wRight.value()) side = 2;
bed.set("side", side);

int tasks = 0;
if (wShower.value()) tasks |= 0x01;
if (wShave.value()) tasks |= 0x02;
if (wBrush.value()) tasks |= 0x04;
bed.set("taskFlags", tasks);

auto eat = new Preferences(app, "Breakfast");

eat.set("drink", wDrink.value());
eat.set("wMilk", wMilk.value());
eat.set("bread", wBread.value());
eat.set("wButter", wButter.value());

eat.set("nEggs", to!int(wEggs.value()));
eat.set("minutes", wMinutes.value());

eat.set("newspaper", wPaper.value());

eat.set("foo", "bar\\nfly\\rBackslash: \\\\ and bell: \\007 and delete: \\177\\n");

eat.set(format("%d", 3), "Test3");

auto eatMore = new Preferences(eat, "More");
eatMore.set("more", "stuff");

int sum = 0;
sum += app.groupExists("Breakfast");
sum += app.groupExists("Breakfast/More");
sum += app.groupExists("./Breakfast/More");
sum += eat.groupExists("More");
sum += eat.groupExists("./Breakfast/More");
sum += eat.groupExists(".");
sum += eat.groupExists("./");
if (sum != 7)
    message("Assertion failed:\\nNot all group entries were found!");}
      {
      }
  }
