# data file for fldtk fluid (Fast Light User Interface Designer)
version 1.0000
comment {About test/preferences:

The preferences app shows two features of FLTK and FLTK.

The Preferences class is used as a storage for user
settings between app launches. Preferences can store
small amounts of arbitrary data in an .ini file format
which can be retrieved again at the next app launch.

FLTK's own version of this demo uses Fluid's GNU-gettext
auto-integration (i18n_type/i18n_include/etc. Option keywords,
auto-wrapping every label in a _() macro) -- that's Fluid-editor-only
tooling with no effect on generated code, so it's dropped here the
same way header_name/code_name are dropped elsewhere; gettext() is
just called directly where needed instead of through a macro (D has
no preprocessor to define one with).

In this small example, gettext is only emulated -- see gettext()
below.
}
  {
    in_source
    in_header
  }
decl {int gLanguage = 0;
// Current languages: 0 = English, 1 = German.

immutable string project = "fltk.org";
immutable string application = "test/preferences";

immutable string[2][] translationTable = [
    ["Alarm at:", "Wecken um:"],
    ["Bread:", "Brot:"],
    ["Breakfast:", "Frühstück:"],
    ["Cancel", "Abbrechen"],
    ["Copy", "Kopieren"],
    ["Cut", "Ausschneiden"],
    ["Drink:", "Getränk:"],
    ["English", "Englisch"],
    ["German", "Deutsch"],
    ["Get Up:", "Aufstehen:"],
    ["Language:", "Sprache:"],
    ["My Preferences", "Meine Vorlieben"],
    ["NY Times", "Der Spiegel"],
    ["Newspaper:", "Tageszeitung:"],
    ["OK", "OK"],
    ["Paste", "Einfügen"],
    ["Please restart the app to use your new language setting.",
     "Bitte starten Sie die App erneut um Ihre Spracheinstellung zu nutzen."],
    ["Wear:", "Schuhwerk:"],
    ["a.m.", "früh"],
    ["bare foot", "barfuß"],
    ["brush teeth", "Zähne putzen"],
    ["coffee", "Kaffee"],
    ["eggs", "Eier"],
    ["flip flops", "Schlappen"],
    ["juice", "Saft"],
    ["left side", "linke Seite"],
    ["min.", "Min."],
    ["of the bed", "vom Bett"],
    ["p.m.", "spät"],
    ["right side", "rechte Seite"],
    ["rye", "Roggen"],
    ["sandals", "Sandalen"],
    ["shave", "rasieren"],
    ["shoes", "Schuhe"],
    ["shower", "duschen"],
    ["sourdough", "Sauerteig"],
    ["tea", "Tee"],
    ["wheat", "Weizen"],
    ["white", "Weißbrot"],
    ["with butter", "mit Butter"],
    ["with milk", "mit Milch"],
];}
  {
    private
    local
  }
Function {gettext(string text)}
  {
    comment {This is a minimal implementation of the GNU gettext API
for systems that don't have GNU libintl library.}
    return_type string
    open
  }
  {
    code {foreach (pair; translationTable)
    if (pair[0] == text)
        return pair[gLanguage];
return text;}
      {
      }
  }
Function {closeWindowCB(Widget w)}
  {
    return_type void
    private
    open
  }
  {
    code fl.core.deleteWidget(myWindow);
      {
      }
  }
Function {saveAndCloseWindowCB(Widget w)}
  {
    return_type void
    private
    open
  }
  {
    code {writePrefs();
fl.core.deleteWidget(myWindow);}
      {
      }
  }
Function {}
  {
    open
  }
  {
    code readLanguagePrefs();
      {
        selected
      }
    Window myWindow
