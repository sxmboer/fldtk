# data file for fldtk fluid (Fast Light User Interface Designer)
version 1.0000
comment {This is make_window()'s own widget-construction piece only --
matching FLTK's real file split (keyboard_ui.fl generates just
this; test/keyboard.cxx is a separate hand-written driver providing
MyWindow's handle() override -- mouse-wheel dispatch to rollerX/
rollerY, referenced here via the "class MyWindow" property -- plus
main() and the polling loop below).

FLTK's own ~90 key buttons share one callback (key_cb) purely as a
*marker* for a polling-introspection trick: the real driver's main
loop scans every button, comparing Fl::event_key()/event_state()
against each one's own registered code, and updates .value()
accordingly -- not a normal fired callback at all (this port doesn't
even set .callback() on these buttons). Ported here as a registration
array instead, matching this port's own already-established
KeyBtn/ShiftBtn redesign: each button's own setup block pushes itself into
keyButtons_/shiftButtons_ via regKey()/regShift() (defined below,
module-level, since Fluid's own widget-tree properties already build
each button -- no addKey()/addShift() *constructor* wrapper needed,
just a *registration* one). regKey()'s own second argument is
optional, defaulting to the button's own label's first character when
omitted (matching that same design's addKey() convenience) -- used for
every plain letter/digit/punctuation key below; every other key passes
its keysym explicitly.

The driver's own polling loop (replacing fl.run() entirely) is:

  while (fl.firstWindow())
    \{
      fl.wait();
      foreach (kb; keyButtons_)
        \{
          bool state = fl.core.eventKey(kb.code);
          if (kb.btn.value() != state) kb.btn.value(state);
        \}
      foreach (sb; shiftButtons_)
        \{
          bool state = fl.core.eventState(sb.bit) != 0;
          if (sb.btn.value() != state) sb.btn.value(state);
        \}
      // ...then update keyOutput/textOutput from fl.core.eventKey()/
      // eventText() -- see MyWindow.d's own main() for the full
      // keyname-formatting logic, not reproduced here since it's
      // driver code, not part of this .fl file's own scope.
    \}
}
  {
    in_source
    in_header
  }
decl {struct KeyBtn
  \{
    Button btn;
    Keysym code;
  \}

struct ShiftBtn
  \{
    Button btn;
    EventState bit;
  \}

KeyBtn[] keyButtons_;
ShiftBtn[] shiftButtons_;

void regKey(Button b, Keysym code = 0)
  \{
    keyButtons_ ~= KeyBtn(b, code != 0 ? code : (b.label().length ? cast(Keysym) b.label()[0] : 0));
  \}

void regShift(Button b, EventState bit)
  \{
    shiftButtons_ ~= ShiftBtn(b, bit);
  \}}
  {
    private
    local
  }
Function make_window()
  {
    return_type void
    open
  }
  {
    Window myWindow
      {
        xywh {448 339 495 215}
        class MyWindow
        type Double
        open
      }
      {
