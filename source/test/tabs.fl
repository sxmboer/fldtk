            Button {}
              {
                label {@>|}
                callback {wWizard.value(wWizard.child(wWizard.children() - 1));}
                xywh {510 305 30 25}
                shortcut {0xff57}
                tooltip {go to last page [End]}
              }
          }
        Button {}
          {
            label {add tab}
            callback {static int n = 6;
int X = tabsGroup.x(), Y = tabsGroup.y() + 25;
int W = tabsGroup.w(), H = tabsGroup.h() - 25;
FlGroup.current(null);
auto newTab = new FlGroup(X, Y, W, H, format("tab%d", n));
newTab.when(whenClosed);
newTab.callback(closeTabCB);
auto box = new Box(X + 5, Y + 5, W - 10, H - 10, format("Empty tab %d.", n));
box.alignment(alignCenter | alignInside);
tabsGroup.add(newTab);
n++;}
            xywh {60 309 70 25}
            tooltip {Add more tabs to check overflow handling.}
          }
        Choice {}
          {
            label {overflow:}
            xywh {212 309 95 25}
            down_box BORDER_BOX
            tooltip {Change how Tabs handles more tabs than fit into the tabs space.}
          }
          {
            MenuItem {}
              {
                label {compress}
                callback {tabsGroup.handleOverflow(overflowCompress);}
              }
            MenuItem {}
              {
                label {clip}
                callback {tabsGroup.handleOverflow(overflowClip);}
              }
            MenuItem {}
              {
                label {pulldown}
                callback {tabsGroup.handleOverflow(overflowPulldown);}
              }
            MenuItem {}
              {
                label {drag}
                callback {tabsGroup.handleOverflow(overflowDrag);}
              }
          }
        Input {}
