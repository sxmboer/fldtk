            Button {}
              {
                label {@|<}
                callback {wWizard.value(wWizard.child(0));}
                xywh {410 305 30 25}
                shortcut {0xff50}
                tooltip {go to first page [Home]}
              }
            Button {}
              {
                label {@<}
                callback {wWizard.prev();}
                xywh {440 305 30 25}
                shortcut {0xff51}
