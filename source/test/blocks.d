// Sound class...
//
// There are MANY ways to implement sound in a FLTK application. The
// approach used here is ALSA on Linux -- the current Xorg releases no
// longer support XBell() or the PC speaker, and Linux/Wayland is this
// project's primary target (see CLAUDE.md); the CoreAudio/Win32 branches
// FLTK carries for macOS/Windows are not transliterated.
class BlockSound
{
    // No ALSA bindings exist in fldtk yet;
    // the real snd_pcm_* code below is kept verbatim, gated behind
    // version(none) so it still compiles once those bindings land --
    // flip this to version(all) at that point to bring it back and
    // verify it against real hardware. Not a permanent removal: the end
    // target is a complete port, sound included.
    version (none)
    {
        private snd_pcm_t* handle_;
    }

    static short[] sampleData;
    static int sampleSize;

    this()
    {
        sampleSize = 0;

        version (none)
        {
            handle_ = null;

            if (snd_pcm_open(&handle_, "default", SndPcmStream.playback, 0) >= 0)
            {
                SndPcmHwParamsT* params;
                snd_pcm_hw_params_alloca(&params);
                snd_pcm_hw_params_any(handle_, params);
                snd_pcm_hw_params_set_access(handle_, params, SndPcmAccess.rwInterleaved);
                snd_pcm_hw_params_set_format(handle_, params, SndPcmFormat.s16);
                snd_pcm_hw_params_set_channels(handle_, params, 2);
                uint rate = 44100;
                int dir;
                snd_pcm_hw_params_set_rate_near(handle_, params, &rate, &dir);
                auto period = cast(snd_pcm_uframes_t) rate;
                snd_pcm_hw_params_set_period_size_near(handle_, params, &period, &dir);

                sampleSize = rate;

                if (snd_pcm_hw_params(handle_, params) < 0)
                {
                    sampleSize = 0;
                    snd_pcm_close(handle_);
                    handle_ = null;
                }
            }
        }

        if (sampleSize)
        {
            // Make an explosion sound by passing white noise through a
            // low pass filter with a decreasing frequency...
            sampleData = new short[2 * sampleSize];

            int maxSample = 2 * sampleSize - 2;
            sampleData[0] = 0;
            sampleData[1] = 0;

            for (int j = maxSample, i = 2; j > 0; j--, i++)
            {
                float freq = cast(float) j / cast(float) maxSample;
                float volume = cast(float)(32767.0 * (0.5 * sqrt(freq) + 0.5));
                float sample = cast(float)(0.0001 * (uniform(0, 20001) - 10000));

                sampleData[i] = cast(short)(volume * freq * sample +
                                             (1.0 - freq) * sampleData[i - 2]);
            }
        }
    }

    ~this()
    {
        version (none)
        {
            if (handle_ !is null)
            {
                snd_pcm_drain(handle_);
                snd_pcm_close(handle_);
            }
        }
    }

    // Play a note for the given amount of time...
    void playExplosion(float duration)
    {
        fl.check();

        if (duration <= 0.0)
            return;

        if (duration > 1.0)
            duration = 1.0;

        int samples = cast(int)(duration * sampleSize);
        auto samplePtr = sampleData[2 * (sampleSize - samples) .. $];

        version (none)
        {
            if (handle_ !is null)
            {
                // Use ALSA to play the sound...
                if (snd_pcm_writei(handle_, samplePtr.ptr, samples) < 0)
                {
                    snd_pcm_prepare(handle_);
                    snd_pcm_writei(handle_, samplePtr.ptr, samples);
                }
            }
        }
    }
}

struct Block
{
    int color;
    bool bomb;
    float y;
}

struct Column
{
    int numBlocks;
    Block[BLOCK_ROWS] blocks;
    float x;
}

class BlockWindow : DoubleWindow
{
    private int frames_;
    private int framesPerSecond_;
    private long frameTime_;
    private bool showFps_;

    private Button helpButton_;
    private Button playButton_;

    private int numColumns_;
    private Column[BLOCK_COLS] columns_;
    private int count_;
    private bool help_;
    private int highScore_;
    private float interval_;
    private int level_;
    private int numColors_;
    private int openedColumns_;
    private bool paused_;
    private static Preferences prefs_;
    private int score_;
    private BlockSound sound_;
    private string title_;
    private int titleY_;

    static this()
    {
        prefs_ = new Preferences(rootUserL, "fltk.org", "blocks");
    }

    this(int X, int Y, int W, int H, string L = null)
    {
        super(X, Y, W, H, L);
        initBlockWindow();
    }

    this(int W, int H, string L = null)
    {
        super(W, H, L);
        initBlockWindow();
    }

    ~this()
    {
        fl.removeTimeout(&timeoutCb);
    }

    private void initBlockWindow()
    {
        init();

        helpButton_ = new Button(0, 0, 20, 20, "?");
        helpButton_.callback((w) { helpCb(); });
        helpButton_.shortcut('?');

        playButton_ = new Button(80, (h() - 80) / 2, 80, 80, "@>");
        playButton_.callback((w) { playCb(); });
        playButton_.labelsize(44);
        playButton_.shortcut(' ');

        sound_ = new BlockSound();

        prefs_.get("high_score", highScore_, 0);

        fl.addTimeout(0.01666666, &timeoutCb);
    }

    // Bomb all blocks of a given color and return the number of affected blocks
    private int bomb(int color)
    {
        int count;

        if (color >= BLOCK_BLAST)
            return 0;

        count = 1;
        for (int j = 0; j < numColumns_; j++)
            for (int k = 0; k < columns_[j].numBlocks; k++)
                if (columns_[j].blocks[k].color == color)
                {
                    columns_[j].blocks[k].color = -color;
                    count++;
                }

        return count;
    }

    // Tag all blocks connected to the clicked block and return the number
    // of affected blocks
    private int click(int col, int row)
    {
        Column* c = &columns_[col];
        int color = c.blocks[row].color;

        if (color < 0 || color >= BLOCK_BLAST)
            return 0;

        // Find the bottom block...
        while (row > 0 && c.blocks[row - 1].color == color)
            row--;

        int count = 0;

        while (row < c.numBlocks && c.blocks[row].color == color)
        {
            c.blocks[row].color = -color;

            if (col > 0 && row < columns_[col - 1].numBlocks &&
                columns_[col - 1].blocks[row].color == color)
            {
                count += click(col - 1, row);
            }

            if (col < (numColumns_ - 1) && row < columns_[col + 1].numBlocks &&
                columns_[col + 1].blocks[row].color == color)
            {
                count += click(col + 1, row);
            }

            count++;
            row++;
        }

        return count;
    }

    // Draw the block window...
    override void draw()
    {
        // Draw the blocks...
        fl_color(black);
        fl_rectf(0, 0, w(), h());

        for (int j = 0; j < numColumns_; j++)
        {
            Column* c = &columns_[j];
            for (int k = 0; k < c.numBlocks; k++)
            {
                Block* b = &c.blocks[k];
                int xx = w() - cast(int) c.x;
                int yy = h() - BLOCK_SIZE - cast(int) b.y;

                if (b.color >= BLOCK_BLAST)
                {
                    b.color++;
                    blastPixmap.draw(xx, yy);
                }
                else if (b.color < 0)
                {
                    if (b.bomb)
                        bombPixmaps[-b.color - 1].draw(xx, yy);
                    else
                        normalPixmaps[-b.color - 1].draw(xx, yy);
                }
                else
                {
                    if (b.bomb)
                        bombPixmaps[b.color - 1].draw(xx, yy);
                    else
                        normalPixmaps[b.color - 1].draw(xx, yy);
                }
            }
        }

        if (interval_ < 0.0 || paused_)
        {
            fl_color(black);
            screenTile.draw(0, 0, w(), h(), 0, 0);
        }

        // Redraw the widgets...
        playButton_.redraw();
        helpButton_.redraw();
        drawChildren();

        // Draw any paused/game over/new game message...
        if ((paused_ || interval_ < 0.0) && playButton_.w() == 80)
        {
            string s;

            if (help_)
            {
                s = "Click on adjacent blocks of the same color. Clear all blocks " ~
                    "before they reach the left side.";

                fl_font(helveticaBold, 24);
                fl_color(black);
                fl_draw(s, 171, 3, w() - 250, h() - 6, alignWrap | alignLeft);

                fl_color(yellow);
                fl_draw(s, 168, 0, w() - 250, h(), alignWrap | alignLeft);
            }
            else
            {
                if (interval_ < 0.0)
                {
                    if (numColumns_ && (Clock.currTime().toUnixTime() & 7) < 4)
                        s = "Game Over";
                    else
                        s = "Block Attack!\nby Michael R Sweet";
                }
                else
                    s = "Paused";

                fl_font(helveticaBold, 32);
                fl_color(black);
                fl_draw(s, 6, 6, w() - 6, h() - 6, alignCenter);

                fl_color(yellow);
                fl_draw(s, 0, 0, w(), h(), alignCenter);
            }
        }

        long curtime = Clock.currTime().toUnixTime();
        frames_++;
        if (curtime > frameTime_)
        {
            framesPerSecond_ = (framesPerSecond_ + 3 * frames_ / cast(int)(curtime - frameTime_)) / 4;
            frames_ = 0;
            frameTime_ = curtime;
        }

        // Draw the scores and level...
        string s;

        s = format(" Score: %d", score_);
        fl_color(white);
        fl_font(helvetica, 14);
        fl_draw(s, 40, 0, w() - 40, 20, alignLeft);

        s = format("High Score: %d ", highScore_);
        fl_draw(s, 0, 0, w(), 20, alignRight);

        if (level_ > 1 || titleY_ <= 0)
        {
            s = format("Level: %d ", level_);
            fl_draw(s, 0, 0, w(), 20, alignCenter);
        }

        if (showFps_)
        {
            s = format("FPS: %d ", framesPerSecond_);
            fl_draw(s, 0, h() - 20, w(), 20, alignLeft);
        }

        if (titleY_ > 0 && interval_ > 0.0)
        {
            int sz = 14 + titleY_ * 86 / h();

            fl_font(helveticaBold, sz);
            fl_color(yellow);
            fl_draw(title_, 0, titleY_, w(), sz, alignCenter);
        }
    }

    // Handle mouse clicks, etc.
    override int handle(Event event)
    {
        if (super.handle(event))
            return 1;
        else if (interval_ < 0.0 || paused_)
            return 0;

        switch (event)
        {
        case keyboard:
            // '+': raise level
            if (fl.eventText() &&
                !fl.eventState(stateCtrl | stateAlt | stateMeta) &&
                fl.eventText() == "+")
            {
                upLevel();
                return 1;
            }

            // ALT + SHIFT + 'H': clear highscore
            if (fl.eventText() &&
                (fl.eventState() & (stateAlt | stateShift)) == (stateAlt | stateShift) &&
                fl.eventText() == "H")
            {
                highScore_ = score_;
                prefs_.set("high_score", highScore_);
                return 1;
            }
            // 'f': toggle showing frames-per-second
            if (fl.eventText() && fl.eventText() == "f")
            {
                showFps_ = !showFps_;
            }
            break;

        case Event.push:
            int mx = w() - fl.eventX() + BLOCK_SIZE;
            int my = h() - fl.eventY();
            int count = 0;
            Block* b = null;
            int hitJ = -1, hitK = -1;

            outer:
            for (int j = 0; j < numColumns_; j++)
                for (int k = 0; k < columns_[j].numBlocks; k++)
                {
                    b = &columns_[j].blocks[k];
                    if (mx >= columns_[j].x && mx < (columns_[j].x + BLOCK_SIZE) &&
                        my >= b.y && my < (b.y + BLOCK_SIZE))
                    {
                        hitJ = j;
                        hitK = k;
                        if (b.bomb)
                            count = bomb(b.color);
                        else
                            count = click(j, k);
                        break outer;
                    }
                }

            if (count < 2)
            {
                for (int j = 0; j < numColumns_; j++)
                    for (int k = 0; k < columns_[j].numBlocks; k++)
                        if (columns_[j].blocks[k].color < 0)
                            columns_[j].blocks[k].color = -columns_[j].blocks[k].color;
            }
            else
            {
                count--;

                if (b !is null && b.bomb)
                {
                    sound_.playExplosion(cast(float)(0.19 + 0.005 * count));

                    interval_ *= BOMB_FACTOR;
                    score_ += count;
                }
                else
                {
                    sound_.playExplosion(cast(float)(0.09 + 0.005 * count));

                    interval_ *= NORMAL_FACTOR;
                    score_ += count * count;
                }

                if (score_ > highScore_)
                {
                    highScore_ = score_;
                    prefs_.set("high_score", highScore_);
                }

                for (int j = 0; j < numColumns_; j++)
                    for (int k = 0; k < columns_[j].numBlocks; k++)
                        if (columns_[j].blocks[k].color < 0)
                            columns_[j].blocks[k].color = BLOCK_BLAST;
            }
            return 1;

        default:
            break;
        }

        return 0;
    }

    // Toggle the on-line help...
    private void helpCb()
    {
        paused_ = help_ = !help_;
        playButton_.label("@>");
        redraw();
    }

    // Initialize the block window...
    private void init()
    {
        frames_ = 0;
        framesPerSecond_ = 0;
        frameTime_ = Clock.currTime().toUnixTime();
        showFps_ = false;
        count_ = 0;
        help_ = false;
        interval_ = -1.0;
        level_ = 1;
        numColors_ = 3;
        numColumns_ = 0;
        paused_ = false;
        score_ = 0;
        title_ = "";
        titleY_ = 0;
    }

    // Start a new game...
    void newGame()
    {
        init();

        interval_ = 0.01666666666f;
        openedColumns_ = 0;

        title_ = "Level: 1";
        titleY_ = h();

        redraw();
    }

    int score()
    {
        return score_;
    }

    // Play/pause...
    private void playCb()
    {
        if (interval_ < 0)
            newGame();
        else
            paused_ = !paused_;

        if (paused_)
            playButton_.label("@>");
        else
        {
            playButton_.label("@-2||");
            help_ = false;
        }
    }

    void upLevel()
    {
        interval_ *= LEVEL_FACTOR;
        openedColumns_ = 0;
        if (numColors_ < 7)
            numColors_++;
        level_++;
        title_ = format("Level: %d", level_);
        titleY_ = h();
    }

    // Animate the game...
    private void timeoutCb()
    {
        // Update blocks that have been destroyed...
        for (int i = 0; i < numColumns_; i++)
        {
            Column* c = &columns_[i];
            for (int j = 0; j < c.numBlocks; j++)
            {
                if (c.blocks[j].color > (BLOCK_BLAST + 5))
                {
                    redraw();

                    c.numBlocks--;

                    if (j < c.numBlocks)
                        memmove(&c.blocks[j], &c.blocks[j + 1],
                                (c.numBlocks - j) * Block.sizeof);

                    j--;

                    if (!c.numBlocks)
                    {
                        numColumns_--;

                        if (i < numColumns_)
                            memmove(&columns_[i], &columns_[i + 1],
                                    (numColumns_ - i) * Column.sizeof);

                        i--;
                        break;
                    }
                }
            }
        }

        // Let the rest of the blocks fall and/or move...
        float lastx = numColumns_ > 0 ? columns_[0].x : 0;
        for (int i = 0; i < numColumns_; i++)
        {
            Column* c = &columns_[i];
            if (c.x > lastx)
            {
                c.x -= 8;
                redraw();
            }

            lastx = c.x + BLOCK_SIZE;

            if (!paused_ && interval_ > 0.0)
            {
                redraw();
                c.x += 0.25;
            }

            float lasty = 0;
            for (int j = 0; j < c.numBlocks; j++)
            {
                Block* b = &c.blocks[j];
                if (b.y > lasty)
                {
                    redraw();
                    b.y -= 4;
                }

                lasty = b.y + BLOCK_SIZE;
            }
        }

        // Slide the title text as needed...
        if (titleY_ > 0)
        {
            redraw();
            titleY_ -= 2;
        }

        // Play the game...
        if (!paused_ && interval_ > 0.0)
        {
            count_--;

            if (count_ <= 0)
            {
                redraw();
                count_ = 4 * BLOCK_SIZE;

                if (numColumns_ == BLOCK_COLS)
                {
                    interval_ = -1.0;
                    sound_.playExplosion(0.8f);
                    playButton_.label("@>");
                }
                else
                {
                    openedColumns_++;

                    if (openedColumns_ > (2 * BLOCK_COLS))
                        upLevel();

                    if (numColumns_)
                        for (int i = numColumns_; i > 0; i--)
                            columns_[i] = columns_[i - 1];

                    numColumns_++;
                    columns_[0].x = 0;
                    columns_[0].numBlocks = BLOCK_ROWS;

                    for (int j = 0; j < BLOCK_ROWS; j++)
                    {
                        columns_[0].blocks[j].bomb = numColors_ > 3 && uniform(0, 128) < numColors_;
                        columns_[0].blocks[j].color = 1 + uniform(0, numColors_);
                        columns_[0].blocks[j].y = cast(float)(j * (BLOCK_SIZE + 8) + 24);
                    }
                }
            }
        }
        else
        {
            count_--;

            if (count_ <= 0)
            {
                count_ = 40;
                redraw();
            }
        }

        // Update the play/pause button as needed...
        if ((paused_ || interval_ < 0.0) && playButton_.w() < 80)
        {
            int s = playButton_.w() + 5;

            playButton_.resize(s, (s - 20) * (h() - s) / 120, s, s);
            playButton_.labelsize(s / 2 + 4);
            redraw();
        }
        else if ((!paused_ && interval_ > 0.0) && playButton_.w() > 20)
        {
            int s = playButton_.w() - 2;

            playButton_.resize(s, (s - 20) * (h() - s) / 120, s, s);
            playButton_.labelsize(s / 2 + 4);
            redraw();
        }

        if (interval_ > 0.0)
            fl.repeatTimeout(interval_, &timeoutCb);
        else
            fl.repeatTimeout(0.1, &timeoutCb);
    }
}

void main(string[] args)
{
    scheme("plastic");
    fl.visibleFocus(false);

    auto bw = new BlockWindow(BLOCK_COLS * BLOCK_SIZE,
                               BLOCK_ROWS * BLOCK_SIZE + 20,
                               "Block Attack!");

    bw.show();

    fl.run();
}
