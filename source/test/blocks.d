// D transliteration of FLTK's test/blocks.cxx (~/Repositories/fltk),
// "Block Attack!" scrolling blocks game.
// Part of the samples/ contract -- see samples/README.md.
// Check: ./samples/build.sh blocks
//
// Notes on this transliteration:
//  - fl.image/fl.bitmap/fl.tiled_image (Pixmap/Bitmap/TiledImage below),
//    fl.preferences (Preferences/Root), and fl.core's timers
//    (addTimeout()/repeatTimeout()/removeTimeout()) are all real,
//    complete ports, used directly below.
//  - The module-level sprite Pixmaps (blastPixmap, red/green/blue/
//    yellow/cyan/magenta/grayPixmap + each color's *BombPixmap, 15
//    objects total, each transliterated verbatim from FLTK's real
//    XPM pixel data) are constructed in a `static this()` before
//    `normalPixmaps`/`bombPixmaps` are built from them: the two lookup
//    arrays capture each Pixmap reference *by value* at array-literal
//    time, so they have to be built after the individual pixmaps exist,
//    not before. screenBitmap/screenTile are constructed the same way,
//    transliterating FLTK's own module-scope `Fl_Bitmap screen_
//    bitmap(screen_bits, 8, 8); Fl_Tiled_Image screen_tile(&screen_
//    bitmap);` directly.
//  - BlockSound is transliterated against the ALSA branch only (FLTK
//    also has CoreAudio and Win32 branches selected by #ifdef) since
//    Linux is this project's primary target (see CLAUDE.md); no ALSA
//    bindings exist in fldtk yet, so the snd_pcm_* calls are kept
//    verbatim but wrapped in version(none) so this sample still
//    compiles -- flip to version(all) once ALSA bindings exist.
import fl;
import std.format : format;
import std.math : sqrt;
import core.stdc.string : memmove;
import std.datetime.systime : Clock;
import std.random : uniform;

enum int BLOCK_COLS = 25;
enum int BLOCK_ROWS = 15;
enum int BLOCK_SIZE = 32;
enum int BLOCK_BLAST = 100;

// These factors are used to fine-tune the game when these events
// occur by multiplying the timer interval with the given factor:
//
// (a) enter the next game level
// (b) click on a "normal block", destroy this one and adjacent blocks
// (c) click on a "bomb", destroy all blocks of the same color
enum float LEVEL_FACTOR = 0.900f; // was: 0.95
enum float NORMAL_FACTOR = 0.999f;
enum float BOMB_FACTOR = 0.995f;

// Set this to true to debug the timer callback (should be false)
enum bool DEBUG_TIMER = false;

