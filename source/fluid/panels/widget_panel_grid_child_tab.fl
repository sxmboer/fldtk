# data file for fldtk fluid (Fast Light User Interface Designer)
version 1.0000
comment {The Grid Child page of widget_panel.fl's property panel, shown in place
of the GUI/Style/C++ tabs when the selected widget's parent is a Grid
(GridNode). Ported from FLTK's fluid/panels/widget_panel/
Grid_Child_Tab.fl.

GridChildTab is a Group, built the same way as GridTab in
widget_panel_grid_tab.fl: widget_panel.fl creates it as its
`widgetTabGridChild` group (with class GridChildTab), and the
constructor builds the widgets inside 400x330, then moves and scales
the group to x, y, w, h.

widget_panel.fl calls load() with the selected child. The fields read
and write the child's cell, `GridNode.cellOf[child]` (a GridCellInfo:
row, col, rowspan, colspan, alignRaw, minW, minH). The page shows the
cell as stored in the project; it does not query the live grid on the
canvas.

The file is named after widget_panel.fl so the two sort together;
widget_panel.fl imports it as `widget_panel_grid_child_tab : GridChildTab`.}
  {
  }
code {import fluid;}
  {
  }
code {import std.algorithm : countUntil;}
  {
  }
class GridChildTab
  {
    : {Group}
  }
  {
    code {private GridNode gn_;}
      {
      }
    code {private Node child_;}
      {
      }
    code {/// FLTK: `wp_gridc_align`'s Horizontal `Fl_Choice` -- real
/// entries only, matching `GRID_LEFT`/`GRID_CENTER`/`GRID_RIGHT`/
/// `GRID_FILL` menu item order.
private immutable string[4] gridAlignHNames =
    ["GRID_LEFT", "GRID_CENTER", "GRID_RIGHT", "GRID_FILL"];
private immutable int[4] gridAlignHValues =
    [gridLeft, gridCenter, gridRight, gridHorizontal];

/// FLTK: `wp_gridc_align`'s Vertical `Fl_Choice`.
private immutable string[4] gridAlignVNames =
    ["GRID_TOP", "GRID_CENTER", "GRID_BOTTOM", "GRID_FILL"];
private immutable int[4] gridAlignVValues =
    [gridTop, gridCenter, gridBottom, gridVertical];}
      {
      }
    Function {this(int x, int y, int w, int h, string label = null)}
      {
        comment {Builds the page at its design size, then moves and scales it to x, y, w, h.}
        open
      }
      {
        code {super(0, 0, 400, 330, label);
labelsize(11);}
          {
          }
        Group {}
          {
            label {Location:}
            xywh {85 30 315 20}
            box FLAT_BOX
            labelfont 1
            labelsize 11
            align 4
          }
          {
            Input widgetGridRowInput
              {
                label {Row:}
                callback {auto cell = cellOrDefault();
try cell.row = to!int(widgetGridRowInput.value()); catch (ConvException) cell.row = 0;
storeCell(cell);
load(child_);}
                xywh {85 30 40 20}
                labelsize 11
                textsize 11
                align 5
              }
            Group {}
              {
                xywh {125 30 30 20}
              }
              {
                Button {}
                  {
                    label {−}
                    callback {int m;
try m = to!int(widgetGridRowInput.value()); catch (ConvException) m = 0;
widgetGridRowInput.value(to!string(m - 1));
widgetGridRowInput.doCallback();}
                    xywh {125 30 15 20}
                    labelsize 11
                    compact {1}
                    setup {o.clearVisibleFocus();}
                  }
                Button {}
                  {
                    label {+}
                    callback {int m;
try m = to!int(widgetGridRowInput.value()); catch (ConvException) m = 0;
widgetGridRowInput.value(to!string(m + 1));
widgetGridRowInput.doCallback();}
                    xywh {140 30 15 20}
                    labelsize 11
                    compact {1}
                    setup {o.clearVisibleFocus();}
                  }
              }
            Input widgetGridColInput
              {
                label {Column:}
                callback {auto cell = cellOrDefault();
try cell.col = to!int(widgetGridColInput.value()); catch (ConvException) cell.col = 0;
storeCell(cell);
load(child_);}
                xywh {165 30 40 20}
                labelsize 11
                textsize 11
                align 5
              }
            Group {}
              {
                xywh {205 30 30 20}
              }
              {
                Button {}
                  {
                    label {−}
                    callback {int m;
try m = to!int(widgetGridColInput.value()); catch (ConvException) m = 0;
widgetGridColInput.value(to!string(m - 1));
widgetGridColInput.doCallback();}
                    xywh {205 30 15 20}
                    labelsize 11
                    compact {1}
                    setup {o.clearVisibleFocus();}
                  }
                Button {}
                  {
                    label {+}
                    callback {int m;
try m = to!int(widgetGridColInput.value()); catch (ConvException) m = 0;
widgetGridColInput.value(to!string(m + 1));
widgetGridColInput.doCallback();}
                    xywh {220 30 15 20}
                    labelsize 11
                    compact {1}
                    setup {o.clearVisibleFocus();}
                  }
              }
            Box {}
              {
                xywh {385 30 1 20}
                hide
                resizable
              }
          }
        Group {}
          {
            label {Align:}
            xywh {85 70 315 20}
            labelfont 1
            labelsize 11
            align 4
          }
          {
            Choice alignHChoice
              {
                label {Horizontal}
                callback {auto cell = cellOrDefault();
int idx = alignHChoice.value();
if (idx < 0 || idx >= gridAlignHValues.length) return;
int mask = gridLeft | gridRight | gridHorizontal;
cell.alignRaw = (cell.alignRaw & ~mask) | gridAlignHValues[idx];
storeCell(cell);}
                xywh {85 70 115 20}
                down_box BORDER_BOX
                labelsize 11
                textsize 11
                align 5
                setup {foreach (name; gridAlignHNames) o.add(name, 0, null);}
              }
              {
              }
            Choice alignVChoice
              {
                label {Vertical}
                callback {auto cell = cellOrDefault();
int idx = alignVChoice.value();
if (idx < 0 || idx >= gridAlignVValues.length) return;
int mask = gridTop | gridBottom | gridVertical;
cell.alignRaw = (cell.alignRaw & ~mask) | gridAlignVValues[idx];
storeCell(cell);}
                xywh {205 70 115 20}
                down_box BORDER_BOX
                labelsize 11
                textsize 11
                align 5
                setup {foreach (name; gridAlignVNames) o.add(name, 0, null);}
              }
              {
              }
            Box {}
              {
                xywh {385 70 1 20}
                hide
