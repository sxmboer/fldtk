    Box {}
      {
        xywh {85 320 300 5}
        labelsize 11
        hide
        resizable
      }
    Function {load(GridNode gn)}
      {
        return_type void
      }
      {
        code {gn_ = gn;
if (gn_ is null) return;
widgetGridRows.value(to!string(gn_.rows));
widgetGridCols.value(to!string(gn_.cols));
marginLeftInput.value(gn_.marginLeft);
marginTopInput.value(gn_.marginTop);
marginRightInput.value(gn_.marginRight);
marginBottomInput.value(gn_.marginBottom);
gapRowInput.value(gn_.gapRow);
gapColInput.value(gn_.gapCol);
// widgetGridCurrRow/Col start out empty (never explicitly initialized);
// loadRowAttrs()/loadColAttrs() below already default an empty or
// unparseable value to 0 on their own, so no pre-seeding is needed here.
loadRowAttrs();
loadColAttrs();}
          {
          }
      }
    Function loadRowAttrs()
      {
        return_type void
      }
      {
        code {if (gn_ is null) return;
int r;
try r = to!int(widgetGridCurrRow.value()); catch (ConvException) r = 0;
if (r < 0) r = 0;
if (gn_.rows > 0 && r >= gn_.rows) r = gn_.rows - 1;
widgetGridCurrRow.value(to!string(r));
widgetGridCurrRowHeight.value(to!string(gridIntAt(gn_.rowHeights, r, 0)));
widgetGridCurrRowWeight.value(to!string(gridIntAt(gn_.rowWeights, r, 0)));
widgetGridCurrRowGap.value(to!string(gridIntAt(gn_.rowGaps, r, -1)));}
          {
          }
      }
    Function loadColAttrs()
      {
        return_type void
      }
      {
        code {if (gn_ is null) return;
int c;
try c = to!int(widgetGridCurrCol.value()); catch (ConvException) c = 0;
if (c < 0) c = 0;
if (gn_.cols > 0 && c >= gn_.cols) c = gn_.cols - 1;
widgetGridCurrCol.value(to!string(c));
widgetGridCurrColWidth.value(to!string(gridIntAt(gn_.colWidths, c, 0)));
widgetGridCurrColWeight.value(to!string(gridIntAt(gn_.colWeights, c, 0)));
widgetGridCurrColGap.value(to!string(gridIntAt(gn_.colGaps, c, -1)));}
          {
          }
      }
    Function {gridIntAt(int[] arr, int idx, int dflt)}
      {
        return_type int
      }
      {
        code {return (idx >= 0 && idx < arr.length) ? arr[idx] : dflt;}
          {
          }
      }
    Function {gridIntSet(ref int[] arr, int idx, int val, int dflt)}
      {
        return_type void
      }
      {
        code {if (idx < 0) return;
while (arr.length <= idx)
  arr ~= dflt;
arr[idx] = val;}
          {
          }
      }
  }
