Function widgetBinToggleVisibility()
  {
    return_type void
  }
  {
    code {if (widgetBinPanel is null)
    makeWidgetBin();

if (widgetBinPanel.shown())
    widgetBinPanel.hide();
else
    widgetBinPanel.show();}
      {
      }
  }
