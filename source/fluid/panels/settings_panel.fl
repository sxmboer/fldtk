Function settingsToggleVisibility()
  {
    return_type void
  }
  {
    code {if (settingsPanel is null)
    makeSettingsPanel();

if (settingsPanel.shown())
    settingsPanel.hide();
else \{
    shellRefreshList();
    layoutRefreshTab();
    settingsPanel.show();
\}}
      {
      }
  }
Function settingsShowShellTab()
  {
    return_type void
  }
  {
    code {if (settingsPanel is null)
    makeSettingsPanel();
shellRefreshList();
settingsTabs.value(shellTab);
settingsPanel.show();}
      {
      }
  }
Function settingsShowLayoutTab()
  {
    comment {Ported from FLTK's `show_grid_cb()` (`Window_Node.cxx`) --
the `&Layout/&Grid and Size Settings...` main-menu item's own callback
(`gui_main.d`), same "jump straight to one tab" shape as
`settingsShowShellTab()` just above.}
    return_type void
  }
  {
    code {if (settingsPanel is null)
    makeSettingsPanel();
layoutRefreshTab();
settingsTabs.value(layoutTab);
settingsPanel.show();}
      {
      }
  }
Function layoutSaveUser()
  {
    comment {Persists the current selection plus every `ToolStore.user`
suite to `appPrefs` -- called from every Layout-tab mutating callback
(`settings_panel.fl`) and from `gui_main.d`'s own main-menu Layout
callbacks, matching this project's established "persist immediately"
convention (see the Layout tab's own top comment for why that's a
deliberate deviation from FLTK's sparser real save cadence, not a
fidelity gap).}
    return_type void
  }
  {
    code {layoutList.writeToPrefs(appPrefs, ToolStore.user);}
      {
      }
  }
Function layoutRefreshTabIfOpen()
  {
    comment {Guarded wrapper for callers outside this module (`gui_main.d`'s
own main-menu Layout callbacks) that don't know whether the Settings
dialog has been constructed yet -- `layoutRefreshTab()` itself assumes
every widget it touches already exists.}
    return_type void
  }
  {
    code {if (settingsPanel !is null) layoutRefreshTab();}
      {
      }
  }
Function layoutRefreshTab()
  {
    comment {Pushes `layoutList`'s current state into every Layout-tab
control -- this dialog's own established "no generic LOAD-propagation
mechanism, just manually re-set every control" convention (see the
User tab's Reset button for the precedent). Called after any
structural change (suite/preset/storage/add/rename/delete/load) and
once before the dialog is ever shown (`settingsToggleVisibility()`/
`settingsShowShellTab()`/`settingsShowLayoutTab()` above) or by
`gui_main.d`'s own main-menu Layout callbacks via
`layoutRefreshTabIfOpen()`.

The storage MenuButton's own per-item enable/disable and radio-check
state is set directly by index (`Menu_.mode(int, MenuFlags)`) rather
than rebuilding the whole array -- matches `fl.file_chooser`'s own
existing use of the same primitive (`favoritesButton.mode(...)`), and
ported from FLTK's own `w_layout_menu`'s LOAD-callback (`
settings_panel.cxx`): index 0 Rename.../1 FLUID Built-In/2 User
Preference/3 Store in .fl Project File/4 Store in External File/5
Load.../6 Save.../7 Delete, matching this tab's own placement order
exactly. Rename/the 3 non-builtin storage options/Delete are active
only when the current suite isn't itself `ToolStore.internal` --
FLTK's own guard, since a built-in suite can be edited in place
(its numeric fields are never gated) but not renamed, restored, or
deleted.}
    return_type void
  }
  {
    code {auto suite = layoutList[layoutList.currentSuiteIndex()];
bool builtin = suite.storage == ToolStore.internal;

MenuItem[] suiteItems;
foreach (i; 0 .. layoutList.size())
    suiteItems ~= MenuItem(layoutList[i].name);
suiteItems ~= MenuItem(null);
layoutChoice.menu(suiteItems);
layoutChoice.value(layoutList.currentSuiteIndex());

layoutMenuButton.mode(0, builtin ? (menuDivider | menuInactive) : menuDivider);
layoutMenuButton.mode(1, menuRadio | menuInactive | (suite.storage == ToolStore.internal ? menuValue : 0));
layoutMenuButton.mode(2, menuRadio | (builtin ? menuInactive : 0) | (suite.storage == ToolStore.user ? menuValue : 0));
layoutMenuButton.mode(3, menuRadio | (builtin ? menuInactive : 0) | (suite.storage == ToolStore.project ? menuValue : 0));
layoutMenuButton.mode(4, menuRadio | menuDivider | (builtin ? menuInactive : 0) | (suite.storage == ToolStore.file ? menuValue : 0));
layoutMenuButton.mode(5, 0);
layoutMenuButton.mode(6, menuDivider);
layoutMenuButton.mode(7, builtin ? menuInactive : 0);

final switch (layoutList.currentPresetIndex())
\{
case 0: layoutPresetApplication.setonly(); break;
case 1: layoutPresetDialog.setonly(); break;
case 2: layoutPresetToolbox.setonly(); break;
\}

auto p = layoutList.current();
layoutWinLeft.value(cast(double) p.leftWindowMargin);
layoutWinTop.value(cast(double) p.topWindowMargin);
layoutWinRight.value(cast(double) p.rightWindowMargin);
layoutWinBottom.value(cast(double) p.bottomWindowMargin);
layoutWinGridX.value(cast(double) p.windowGridX);
layoutWinGridY.value(cast(double) p.windowGridY);

layoutGrpLeft.value(cast(double) p.leftGroupMargin);
layoutGrpTop.value(cast(double) p.topGroupMargin);
layoutGrpRight.value(cast(double) p.rightGroupMargin);
layoutGrpBottom.value(cast(double) p.bottomGroupMargin);
layoutGrpGridX.value(cast(double) p.groupGridX);
layoutGrpGridY.value(cast(double) p.groupGridY);

layoutTabsTop.value(cast(double) p.topTabsMargin);
layoutTabsBottom.value(cast(double) p.bottomTabsMargin);

layoutWidgetMinW.value(cast(double) p.widgetMinW);
layoutWidgetIncW.value(cast(double) p.widgetIncW);
layoutWidgetGapX.value(cast(double) p.widgetGapX);
layoutWidgetMinH.value(cast(double) p.widgetMinH);
layoutWidgetIncH.value(cast(double) p.widgetIncH);
layoutWidgetGapY.value(cast(double) p.widgetGapY);

layoutLabelFontChoice.value(p.labelfont >= 0 ? p.labelfont : 0);
layoutLabelSizeInput.value(cast(double) p.labelsize);
layoutTextFontChoice.value(p.textfont >= 0 ? p.textfont : 0);
layoutTextSizeInput.value(cast(double) p.textsize);

layoutChoice.redraw();
layoutMenuButton.redraw();}
      {
      }
  }
Function makeScriptPanel()
  {
  }
  {
    Window scriptPanel
      {
        label {Shell Script Editor}
        xywh {0 0 540 184}
        type Double
        resizable
        modal
      }
      {
        TextEditor scriptInput
          {
            xywh {10 10 520 130}
            box DOWN_BOX
            setup {o.buffer(new TextBuffer());}
            resizable
          }
        Group {}
          {
            xywh {10 150 520 24}
          }
          {
            Button {}
              {
                label {Cancel}
                callback {shellScriptCancel();}
                xywh {348 150 88 24}
              }
            ReturnButton {}
              {
                label {OK}
                callback {shellScriptOk();}
                xywh {442 150 88 24}
              }
          }
      }
  }
