Function makeSettingsPanel()
  {
  }
  {
    Window settingsPanel
      {
        label {FLUID Settings}
        xywh {0 0 360 585}
        type Double
        resizable
      }
      {
        Tabs settingsTabs
          {
            xywh {10 10 340 530}
            resizable
          }
          {
            Group generalTab
              {
                label {General}
                xywh {10 60 340 480}
                scale_image {36 24}
                image {pixmaps/general_64.png}
                compress_image 1
              }
              {
                Group {}
                  {
                    xywh {130 78 210 25}
                  }
                  {
                    Choice schemeChoice
                      {
                        label {Scheme: }
                        callback {fl.core.scheme(schemeChoice.text());
appPrefs.set("scheme", schemeChoice.text());}
                        xywh {130 78 120 25}
                        down_box BORDER_BOX
                        labelfont 1
                        labelsize 12
                        textsize 12
                        setup {string s;
appPrefs.get("scheme", s, "none");
int idx = o.findIndex(s);
if (idx >= 0) o.value(idx);
fl.core.scheme(s == "none" ? null : s);}
                      }
                      {
                        MenuItem {}
                          {
                            label {none}
                          }
                        MenuItem {}
                          {
                            label {gtk+}
                          }
                        MenuItem {}
                          {
                            label {gleam}
                          }
                        MenuItem {}
                          {
                            label {oxy}
                          }
                        MenuItem {}
                          {
                            label {plastic}
                          }
                      }
                    Box {}
                      {
                        xywh {250 78 10 25}
                        hide
                        resizable
                      }
                  }
                Box {}
                  {
                    label {Options: }
                    xywh {130 115 0 20}
                    labelfont 1
                    labelsize 12
                    align 4
                  }
                CheckButton tooltipsButton
                  {
                    label {Show Tooltips}
                    callback {fl.tooltip.enable(tooltipsButton.value() != 0);
appPrefs.set("show_tooltips", tooltipsButton.value());}
                    xywh {130 115 210 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {int b;
appPrefs.get("show_tooltips", b, 1);
o.value(b != 0);
fl.tooltip.enable(b != 0);}
                  }
                CheckButton completionButton
                  {
                    label {Show Completion Dialogs}
                    callback {appPrefs.set("show_completion_dialogs", completionButton.value());}
                    xywh {130 135 210 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {int b;
appPrefs.get("show_completion_dialogs", b, 1);
o.value(b != 0);}
                  }
                CheckButton openlastButton
                  {
                    label {Open Previous File on Startup}
                    callback {appPrefs.set("open_previous_file", openlastButton.value());}
                    xywh {130 155 210 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {int b;
appPrefs.get("open_previous_file", b, 0);
o.value(b != 0);}
                  }
                CheckButton prevposButton
                  {
                    label {Remember Window Positions}
                    callback {appPrefs.set("prev_window_pos", prevposButton.value());}
                    xywh {130 175 210 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {int b;
appPrefs.get("prev_window_pos", b, 1);
o.value(b != 0);}
                  }
                CheckButton showCommentsButton
                  {
                    label {Show Comments in Browser}
                    callback {showComments = showCommentsButton.value() != 0;
appPrefs.set("show_comments", showCommentsButton.value());
auto b = browser();
if (b !is null) \{ b.recalcTree(); b.redraw(); \}}
                    xywh {130 195 210 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {int b;
appPrefs.get("show_comments", b, 1);
o.value(b != 0);
showComments = b != 0;}
                  }
                Group {}
                  {
                    xywh {130 225 210 20}
                  }
                  {
                    Spinner recentSpinner
                      {
                        label {\# Recent Files:}
                        callback {appPrefs.set("recent_files", recentSpinner.value());
reloadRecentFiles();}
                        xywh {130 225 40 20}
                        labelfont 1
                        labelsize 12
                        textsize 12
                        maximum {10}
                        setup {int c;
appPrefs.get("recent_files", c, 5);
o.maximum(10);
o.value(c);}
                      }
                    Box {}
                      {
                        xywh {170 225 10 20}
                        hide
                        resizable
                      }
                  }
                Input editorCommandField
                  {
                    label {External Editor:}
                    callback {appPrefs.set("external_editor_command", editorCommandField.value());}
                    xywh {130 255 210 20}
                    labelfont 1
                    labelsize 12
                    setup {string s;
appPrefs.get("external_editor_command", s, "");
o.value(s);}
                    tooltip {The editor command to open your external text editor.
Include any necessary flags to ensure your editor does not background itself.
Examples:
    gvim -f
    gedit
    emacs}
                  }
                CheckButton useExternalEditorButton
                  {
                    label {Use for Code Nodes}
                    callback {appPrefs.set("use_external_editor", useExternalEditorButton.value());}
                    xywh {130 278 210 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {int b;
appPrefs.get("use_external_editor", b, 0);
o.value(b != 0);}
                  }
                Box {}
                  {
                    label {Overlays: }
                    xywh {130 306 0 20}
                    labelfont 1
                    labelsize 12
                    align 4
                  }
                CheckButton guidesButton
                  {
                    label {Show Positioning Guides}
                    callback {showGuides(guidesButton.value() != 0);}
                    xywh {130 306 210 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {o.value(showGuides());}
                    tooltip {show guides that help to position and resize widgets and enable snapping}
                  }
                CheckButton restrictedButton
                  {
                    label {Show Restricted Areas}
                    callback {showRestricted(restrictedButton.value() != 0);}
                    xywh {130 326 210 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {o.value(showRestricted());}
                    tooltip {show overlapping and out of bounds areas, show unfilled areas in Pack groups}
                  }
                CheckButton ghostedOutlineButton
                  {
                    label {Show Ghosted Group Outlines}
                    callback {showGhostedOutline(ghostedOutlineButton.value() != 0);}
                    xywh {130 346 210 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {o.value(showGhostedOutline());}
                    tooltip {groups with no box type or flat boxtypes without contrast will be rendered with a dim outline in the editing window only}
                  }
              }
            Group projectTab
              {
                label {Project}
                comment {Header File, Include Header from Code, and Include Guard are
dropped entirely (not just left unwired) -- all three are pure C/C++
header-file concepts (a `.h` companion file, `\#include`-ing it from
the `.cxx`, an `\#ifndef` guard macro against multiple inclusion) with
no equivalent in this dialect's single-generated-`.d`-file model at
all, unlike Project tab fields elsewhere that just lack a *backing
subsystem* yet. The old "name.ext"/".ext"-shorthand instructional box
went with them: that convention existed FLTK to keep a `.cxx`/`.h`
pair's basenames in sync, which stops mattering with only one output
file to name. Code File is real and wired now (`gui_main.codeFileName()`)
-- the interactive equivalent of the headless `fluid -c -o` flag,
letting the generated `.d` file's own name/path differ from the `.fl`
project's, exactly the shape FLTK's own command-line tool already
has (`fluid.app`'s own `-o` vs. this same `code_name` fallback).
Simplified from FLTK's own three-case `codefile_name()` resolution
down to two (see `gui_main.codeFileName_`'s own doc comment) -- this
dialect always writes `.d` regardless of what's typed, so FLTK's
"type just an extension" shorthand has no real use case with nothing
else to keep in sync.

Allow Unicode UTF-8 in source code / Avoid early include of Fl.H --
both gate a mechanism that
provably doesn't exist as a category in D, not just "no backing
subsystem yet": `Code_Writer.cxx`'s own `write_string()` shows the
UTF-8 checkbox only chooses between writing a non-ASCII byte raw or
octal-escaping it for older-compiler safety -- `code_writer.d`'s own
`dStringEscape()` already only escapes `"`/``/`
` and passes every
other byte (including UTF-8) through unconditionally, since D source
is UTF-8 by spec; there's only one behavior, and it's already what
"checked" means in FLTK. The early-include checkbox only controls
*where in the generated header* `\#include <FL/Fl.H>` textually lands
(`write_prologue()`'s unconditional top-of-file write vs. each node's
own lazy `write_h_once()` call at first use) -- meaningful in C++
because textual, order-sensitive `\#include` can have macro/
conditional-compilation side effects; D's `import` has no textual
substitution and no order-dependent semantics at all, so there is no
scenario where moving `import fl;` earlier or later in a file changes
anything. Menu shortcuts use stateCommand (a real, portable, cross-
platform shortcut-generation behavior) is unaffected by this reasoning
and is wired (`gui_main.projectSettings()`, round-tripped as the bare
`use_FL_COMMAND` Option). Generate MergeBack data (FLTK's own
experimental feature) is wired the same way (`mergeback 1`); see
`fluid.mergeback`.}
                xywh {10 60 340 480}
                scale_image {36 24}
                image {pixmaps/document_64.png}
                compress_image 1
                hide
              }
              {
                Input codeFileField
                  {
                    label {Code File:}
                    callback {*(codeFileName()) = codeFileField.value();}
                    xywh {110 90 230 20}
                    box THIN_DOWN_BOX
                    labelfont 1
                    labelsize 12
                    textsize 12
                    textfont 4
                    setup {o.value(*(codeFileName()));}
                    tooltip {Overrides the generated .d file's own name (and, if it contains a path, its output directory) independently of the .fl project file's own name. Leave blank to use the project's own basename.}
                  }
                Box {}
                  {
                    label {Options: }
                    xywh {110 130 0 20}
                    labelfont 1
                    labelsize 12
                    align 4
                  }
                CheckButton useFlCommandButton
                  {
                    label {Menu shortcuts use stateCommand}
                    callback {projectSettings().useFlCommand = useFlCommandButton.value() != 0;}
                    xywh {110 130 230 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {o.value(projectSettings().useFlCommand);}
                    tooltip {Write the Ctrl and Meta modifiers of every generated widget and menu shortcut as the platform-neutral stateCommand and stateControl names instead of stateCtrl and stateMeta, so shortcuts follow the platform's command key.}
                  }
                Box {}
                  {
                    label {Experimental: }
                    xywh {110 150 0 20}
                    labelfont 1
                    labelsize 12
                    align 4
                  }
                CheckButton mergebackButton
                  {
                    label {Generate MergeBack data}
                    callback {projectSettings().writeMergebackData = mergebackButton.value() != 0;
updateMergebackMenu();}
                    xywh {110 150 230 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {o.value(projectSettings().writeMergebackData);}
                    tooltip {MergeBack is a feature under construction that allows changes in code files to be merged back into the project file. Checking this option will generate additional data in code and project files.}
                  }
                Box {}
                  {
                    label {Build: }
                    xywh {110 170 0 20}
                    labelfont 1
                    labelsize 12
                    align 4
                  }
                CheckButton dubHeaderButton
                  {
                    label {Dub single-file-package header}
                    callback {*(projectDubHeader()) = dubHeaderButton.value() != 0;}
                    xywh {110 170 230 20}
                    down_box DOWN_BOX
                    labelsize 12
                    setup {o.value(*(projectDubHeader()));}
                    tooltip {Adds a leading dub single-file-package comment (dependency "fldtk" path="...") to the generated .d file, so it can be built directly with 'dub build --single' or 'dub run --single' -- no manually-typed linker flags needed. Same effect as fluid -c's --dub-header flag.}
                  }
              }
            Group layoutTab
              {
                label {Layout}
                comment {Wired for real: `fluid.layout_suite`'s `layoutList` (`LayoutList`/
`LayoutSuite`/`LayoutPreset`, ported from FLTK's `Layout_List`/
`Layout_Suite`/`Layout_Preset`) is a real, working
subsystem backing drag-time snap guides and idealSizeFor(), with a real UI plus the storage-switching/`.fl`-project/`.fll`-file
persistence FLTK has (see `layout_suite.d`'s own top comment for the full mechanism).
Every control below reads/writes `layoutList.current()` (the active
suite's active preset) for real and calls `layoutRefreshTab()` after any
structural change (suite/preset/storage/add/rename/delete/load), the
same "manually push model state back into every control" shape the User
tab's own Reset button already established for this dialog (no generic
`propagate_load()`-style LOAD-sentinel mechanism exists here). Persists
immediately on every change (`layoutSaveUser()`), matching this
project's own established convention (`fluid.node_browser`'s
`savePrefs()`, `fluid.shell_command`'s `onShellListChanged`) rather than
FLTK's own sparser "only at app exit or dialog Close" cadence -- a
deliberate consistency choice, not a fidelity gap: FLTK's own real
call sites are `Fluid.cxx`'s app-exit path and `cb_Close()`, both just
batching writes that would otherwise happen this same way. One
already-established simplification carried over from the User tab:
the "FLUID Built-In"/"User Preference"/"Store in .fl Project File"/
"Store in External File" storage menu items keep FLTK's text minus
its leading `@fd_beaker`/`@fd_user`/`@fd_project`/`@fd_file` symbol
(`fl_add_symbol()` glyphs, not ported -- the User tab omits them too).}
                xywh {10 60 340 480}
                scale_image {36 24}
                image {pixmaps/layout_64.png}
                compress_image 1
                hide
              }
              {
                Box {}
                  {
                    label {Layout:}
                    xywh {20 78 75 24}
                    labelfont 1
                    labelsize 12
                    align 24
                  }
                Choice layoutChoice
                  {
                    callback {layoutList.currentSuite(o.value());
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                    xywh {95 78 197 24}
                    down_box BORDER_BOX
                    labelsize 12
                    textsize 12
                  }
                  {
                    MenuItem {}
                      {
                        label {FLTK}
                      }
                    MenuItem {}
                      {
                        label {Grid}
                      }
                  }
                Button {}
                  {
                    label {+}
                    callback {string oldName = "Copy of " ~ layoutList[layoutList.currentSuiteIndex()].name;
string newName = fl_input("Enter a name for the new layout:", oldName);
if (newName is null) return;
layoutList.add(newName);
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                    xywh {292 78 24 24}
                    labelsize 12
                    tooltip {Clone the current layout suite}
                  }
                MenuButton layoutMenuButton
                  {
                    xywh {316 78 24 24}
                    labelsize 12
                  }
                  {
                    MenuItem {}
                      {
                        label {Rename...}
                        callback {string oldName = layoutList[layoutList.currentSuiteIndex()].name;
string newName = fl_input("Enter a new name for the layout:", oldName);
if (newName is null) return;
layoutList.rename(newName);
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                        divider
                      }
                    MenuItem {}
                      {
                        label {FLUID Built-In}
                        callback {layoutList[layoutList.currentSuiteIndex()].storage = ToolStore.internal;
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                        type Radio
                        deactivate
                      }
                    MenuItem {}
                      {
                        label {User Preference}
                        callback {layoutList[layoutList.currentSuiteIndex()].storage = ToolStore.user;
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                        type Radio
                      }
                    MenuItem {}
                      {
                        label {Store in .fl Project File}
                        callback {layoutList[layoutList.currentSuiteIndex()].storage = ToolStore.project;
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                        type Radio
                      }
                    MenuItem {}
                      {
                        label {Store in External File}
                        callback {layoutList[layoutList.currentSuiteIndex()].storage = ToolStore.file;
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                        type Radio
                        divider
                      }
                    MenuItem {}
                      {
                        label {Load...}
                        callback {if (layoutList.filename.length == 0) layoutList.filename = "layout.fll";
string filename = fileChooser("Import Layout Settings", "*.fll", layoutList.filename);
if (filename.length == 0) return;
layoutList.load(filename);
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                      }
                    MenuItem {}
                      {
                        label {Save...}
                        callback {if (layoutList.filename.length == 0) layoutList.filename = "layout.fll";
string filename = fileChooser("Export Layout Settings", "*.fll", layoutList.filename);
if (filename.length == 0) return;
layoutList.save(filename);}
                        divider
                      }
                    MenuItem {}
                      {
                        label {Delete}
                        callback {layoutList.remove(layoutList.currentSuiteIndex());
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                      }
                  }
                Box {}
                  {
                    label {Preset:}
                    xywh {20 107 75 20}
                    labelfont 1
                    labelsize 12
                    align 24
                  }
                Group {}
                  {
                    xywh {95 107 245 20}
                  }
                  {
                    Button layoutPresetApplication
                      {
                        label {Application}
                        callback {layoutList.currentPreset(0);
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                        xywh {95 107 81 20}
                        selection_color 45
                        labelsize 12
                        value {1}
                        compact {1}
                        type Radio
                      }
                    Button layoutPresetDialog
                      {
                        label {Dialog}
                        callback {layoutList.currentPreset(1);
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                        xywh {176 107 82 20}
                        selection_color 45
                        labelsize 12
                        compact {1}
                        type Radio
                      }
                    Button layoutPresetToolbox
                      {
                        label {Toolbox}
                        callback {layoutList.currentPreset(2);
layoutSaveUser();
layoutRefreshTab();
rebuildLayoutMenu();}
                        xywh {258 107 82 20}
                        selection_color 45
                        labelsize 12
                        compact {1}
                        type Radio
                      }
                  }
                Box {}
                  {
                    label {---- Window ----}
                    xywh {95 132 235 20}
                    labelfont 1
                    labelsize 12
                    align 20
                  }
                Box {}
                  {
                    label {Margins:}
                    xywh {20 167 75 20}
                    labelfont 1
