              {
                Group {}
                  {
                    xywh {110 78 170 20}
                  }
                  {
                    Choice i18nTypeChooser
                      {
                        label {i18n Library:}
                        callback {auto s = projectI18n();
final switch (cast(I18nType) i18nTypeChooser.value())
\{
case I18nType.none:
    s.type = I18nType.none;
    i18nGnuGroup.hide();
    i18nPosixGroup.hide();
    break;
case I18nType.gnu:
    s.type = I18nType.gnu;
    i18nGnuGroup.show();
    i18nPosixGroup.hide();
    break;
case I18nType.posix:
    s.type = I18nType.posix;
    i18nGnuGroup.hide();
    i18nPosixGroup.show();
    break;
\}}
                        xywh {110 78 160 20}
                        box THIN_UP_BOX
                        down_box BORDER_BOX
                        labelfont 1
                        labelsize 12
                        textsize 12
                        setup {o.value(cast(int) projectI18n().type);}
                        tooltip {Type of internationalization to use.}
                      }
                      {
                        MenuItem {}
                          {
                            label {None}
                            labelsize 12
                          }
                        MenuItem {}
                          {
                            label {GNU gettext}
                            labelsize 12
                          }
                        MenuItem {}
                          {
                            label {POSIX catgets}
                            labelsize 12
                          }
                      }
                    Box {}
                      {
                        xywh {270 78 10 20}
                        hide
                        resizable
                      }
                  }
                Group i18nGnuGroup
                  {
                    xywh {110 103 230 95}
                    labelsize 12
                    setup {if (projectI18n().type == I18nType.gnu) o.show(); else o.hide();}
                  }
                  {
                    Input {}
                      {
                        label {Import:}
                        callback {projectI18n().gnuInclude = o.value();}
                        xywh {110 103 230 20}
                        box THIN_DOWN_BOX
                        labelsize 12
                        textsize 12
                        textfont 4
                        setup {o.value(projectI18n().gnuInclude);}
                        tooltip {What to import for internationalization support, as a D import path such as fl.gettext. It must provide the translation function named below. Leave empty to import nothing and define the function yourself in a "decl" block.}
                      }
                    Input {}
                      {
                        label {Conditional:}
                        callback {projectI18n().gnuConditional = o.value();}
                        xywh {110 128 230 20}
                        box THIN_DOWN_BOX
                        labelsize 12
                        textsize 12
                        textfont 4
                        setup {o.value(projectI18n().gnuConditional);}
                        tooltip {Only import internationalization support if this D version identifier is defined, for example ENABLE_NLS. Otherwise the generated file defines pass-through functions that return the text untranslated. Leave empty to always import.}
                      }
                    Input {}
                      {
                        label {Function:}
                        callback {projectI18n().gnuFunction = o.value();}
                        xywh {110 153 230 20}
                        box THIN_DOWN_BOX
                        labelsize 12
                        textsize 12
                        textfont 4
                        setup {o.value(projectI18n().gnuFunction);}
                        tooltip {The function to call to translate labels and tooltips, usually "gettext" or "_"}
                      }
                    Input {}
                      {
                        label {Static Function:}
                        callback {projectI18n().gnuStaticFunction = o.value();}
                        xywh {110 178 230 20}
                        box THIN_DOWN_BOX
                        labelsize 12
                        textsize 12
                        textfont 4
                        setup {o.value(projectI18n().gnuStaticFunction);}
                        tooltip {function to call to internationalize labels and tooltips, usually "gettext_noop" or "N_"}
                      }
                  }
                Group i18nPosixGroup
