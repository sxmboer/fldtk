Function makeImagePanel()
  {
    comment {Create a panel for editing widget image data}
    return_type void
    open
  }
  {
    Window imagePanelWindow
      {
        label {Image Options}
        xywh {622 649 260 332}
        type Double
      }
      {
        Group imagePanelImagegroup
          {
            xywh {10 15 235 125}
          }
          {
            Box {}
              {
                label { ---- Active Image ----}
                xywh {75 15 170 20}
                labelfont 1
                labelsize 11
                align 20
              }
            Box imagePanelData
              {
                label {... x ... pixels, ...}
                xywh {75 35 170 20}
                labelsize 11
                align 20
              }
            Group {}
              {
                xywh {75 75 170 20}
              }
              {
                Input imagePanelImageW
                  {
                    label {Width:}
                    callback {auto v = imagePanelImageW.value();
foreach (wn; selectedWidgetNodes())
  wn.scaleImageW = v;}
                    xywh {75 75 55 20}
                    labelsize 11
                    textsize 11
                    class FormulaInput
                    align 5
                    tooltip {Scale image to this width in pixel units; 0 keeps the original size}
                  }
                Input imagePanelImageH
                  {
                    label {Height:}
                    callback {auto v = imagePanelImageH.value();
foreach (wn; selectedWidgetNodes())
  wn.scaleImageH = v;}
                    xywh {135 75 55 20}
                    labelsize 11
                    textsize 11
                    class FormulaInput
                    align 5
                    tooltip {Scale image to this height in pixel units; 0 keeps the original size}
