comment {---- widget_tabs (the GUI/Style/C++ property-editing tabs) ----

Converted from FLTK's real `widget_panel_callbacks.cxx`, merged
with the already-reasoned-through logic in `widget_panel.d`
(`WidgetPanelDialog`, kept as reference material). Deliberate
simplifications, consistent with the other 8 already-converted pages
in this file:
  - Live-canvas-widget updates and undo-checkpoint calls are gui_main.d's
    own job, not this file's: `onBeforeEdit`/`onEdited` (declared just
    above, assigned by `gui_main.d` before `make_widget_panel()` runs)
    are the hook every edit callback in this file calls around its own
    mutation, and `wireEditHooks()` (also just above) wraps every
    property-editing widget under `widgetTabs` with them automatically
    -- `gui_main.d` calls it once, right after `make_widget_panel()`.
  - Multi-select apply is real: most field
    callbacks below loop over `selectedWidgetNodes()`/`selectedWindowNodes()`/
    `selectedFlexNodes()`/`selectedMenuItemNodes()` (all thin filters over
    `selectedNodes_`, this file's own equivalent of FLTK's
    `Fluid.proj.tree.all_selected_widgets()`), matching FLTK's real
    per-field loop shape -- confirmed field by field against the real
    `widget_panel.cxx`/`widget_panel_callbacks.cxx`, not assumed
    uniform. A few fields stay genuinely single-target because FLTK's
    own real callback does too, not because this port hasn't caught up:
    `cppNameInput` (`cb_10` hides the field entirely once more than one
    widget is selected -- a name must stay unique per widget), and
    `attrResizable`/`attrHotspot` (`cb_Resizable`/`cb_Hotspot` both
    `deactivate()` the control on `numselected > 1`). `Border`/`Modal`/
    `Nonmodal` (`cb_Border`/`cb_Modal`) were never looped by FLTK either
    -- window-only fields with no real multi-window use case. This
    load-side deactivation on multi-select is replicated for
    `attrResizable`/`attrHotspot`; the control stays single-target on store.
  - `fluid.formula_input.FormulaInput` (typed formulas with variables
    like `x`, `px`, `i`) backs X/Y/W/H and the Image Options dialog's
    scale fields --
    X/Y/W/H's own callbacks re-bind `positionVars(wn, i)` and re-evaluate
    the formula once per selected widget, matching FLTK's own
    `cb_widget_x_input()` (`o->variables(widget_vars, q); v = o->value();`
    inside its own per-widget loop) rather than evaluating the formula
    once and broadcasting the same number to every node. The Values
    group's 5 fields are still plain `ValueInput`, matching
    `widget_panel.d`'s own prior judgment call on that narrower point.
  - Every control's availability follows FLTK's own load branches:
    the Values fields dispatch on the live widget's class
    (`loadValuesFields()`); image, X/Y/W/H, Visible/Active, colors,
    Down Box, text font/size/color, label margins, Compact and Subclass
    are greyed or hidden by node kind at the end of
    `propagateLoadWidget()`.
  - `widget_tab_grid`/`widget_tab_grid_child` (the two embedded
    Grid-specific sub-panels, `GridTab`/`GridChildTab`) are real and
    placed into/out of `widgetTabs` by `propagateLoadWidget()`'s own
    reparenting logic, matching FLTK. The "Values:" group's
    Grid_Node hide check is ported too (cheap, needs only the type, not
    an instance).}
  {
    in_source
    in_header
  }
decl {/// FLTK: `wp_gui_alignment`'s Position `Fl_Choice` menu. The *names*
/// (`wpGuiAlignPosChoice`'s own menu text) are literal `MenuItem \{\}`
/// children, not a `setup\{\}` snippet -- `fluid.instantiate.applyMenuItems()` only
/// ever populates a Choice from real, declarative `MenuItem \{\}`
/// children, never from `setup\{\}` code.
/// Only the index->bitmask lookup stays here, in the same order the
/// `MenuItem \{\}` children are declared in, one entry per child
/// (including the 2 bold, non-selectable section-header entries --
/// `"   Inside && Outside   "`/`"   Outside Alignment   "`, matching
/// FLTK's own `alignmenu`-adjacent literal text exactly, included as
/// inert `-1`
/// entries the way FLTK's own `user_data -1` sentinel does). A `-1`
/// here means "one of those two headers"; the store-side callback below
/// treats it as a no-op selection, matching FLTK's own
/// `align_position_cb()` (`if ((fl_intptr_t)o->mvalue()->user_data() ==
/// -1) return;`).
private immutable int[15] alignPositionChoiceValues = [
    -1,
    alignTopLeft, alignTop, alignTopRight, alignLeft, alignCenter, alignRight,
    alignBottomLeft, alignBottom, alignBottomRight,
    -1,
    alignLeftTop, alignRightTop, alignLeftBottom, alignRightBottom,
];

/// FLTK: `wp_gui_alignment`'s image-relation `Fl_Choice` menu. Same
/// shape as `alignPositionChoiceValues` just above: index 0 is the bold
/// `"   Image Alignment   "` header (`-1`, a no-op selection), matching
/// FLTK's own leading header item there.
private immutable int[6] alignImageChoiceValues = [
    -1,
    alignImageOverText, alignTextOverImage, alignTextNextToImage,
    alignImageNextToText, alignImageBackdrop,
];

/// FLTK: `Fl_File_Chooser`'s own image-extension filter.
private immutable string imageFilter =
    "*.\{png,jpg,jpeg,gif,bmp,xpm,xbm,ico,svg,svgz,pnm,pbm,pgm,ppm\}";

// FLTK: `fontmenu[]`, the 16 built-in FLTK faces. `styleLabelFont`/
// `styleTextFont` both set `uses_font_menu` (see
// `fluid.font_menu`'s own module comment for the full mechanism) --
// a Choice's own selected index already *is* the `Font` enum value for
// these 16 built-ins, so no separate index->value lookup array was
// ever needed here, unlike `alignPositionChoiceValues`/
// `labeltypeKeywords` above.

// FLTK: `colormenu[]`, the quick-pick list each of the 4 color swatch
// buttons' `Fl_Menu_Button` sibling opens. Lives in
// `fluid.color_menu` (see
// that module's own doc comment), shared with `settings_panel.fl`'s
// own 6 role-color swatches, rather than each panel duplicating a
// `setup\{foreach...\}`-populated
// `Menu_Button` (which would mean an always-empty live-canvas dropdown while
// editing this very file, and would drop FLTK's own 2 `FL_MENU_DIVIDER`s). Each of the 4
// `Menu_Button`s below sets `uses_color_menu` and keeps its own existing
// single callback reading `.value()` back against `colorMenuValues`
// (still imported, now from `fluid.color_menu` via this file's own
// `import fluid;`, not declared here).

/// FLTK: `boxmenu[]`, every registered boxtype -- matches
/// `fluid.instantiate.boxtypeMap`'s own keys, populated at startup
/// since they aren't a compile-time constant.
private string[] boxtypeNames;

shared static this()
\{
    import std.array : array;
    import std.algorithm : sort;

    // Enum order keeps each scheme's boxes together and in FLTK's order.
    boxtypeNames = boxtypeMap.byKeyValue.array
        .sort!((a, b) => a.value < b.value)
        .map!(kv => kv.key).array;
\}

/// Display text and scheme submenu of a boxtype keyword
/// (`"GTK_UP_BOX"` -> `("GTK+", "GTK Up Box")`).
private string[2] boxtypeMenuParts(string keyword)
\{
    import std.string : split, capitalize;
    import std.array : join;
    import std.algorithm : map;

    static immutable string[2][5] schemes = [
        ["PLASTIC_", "Plastic"], ["GTK_", "GTK+"], ["GLEAM_", "Gleam"],
        ["OXY_", "Oxy"], ["", "Standard"]];
    string scheme = "Standard";
    foreach (sc; schemes)
        if (sc[0].length == 0 || keyword.startsWith(sc[0]))
        \{
            scheme = sc[1];
            break;
        \}
    string text = keyword.split("_").map!(w => w.capitalize).join(" ");
    if (scheme == "GTK+") text = "GTK" ~ text[3 .. $];
    return [scheme, text];
\}

/// Fills a boxtype `Choice` with one submenu per scheme (Standard,
/// Plastic, GTK+, Gleam, Oxy); returns, for each entry of
/// `boxtypeNames`, its index in the Choice's menu.
private int[] populateBoxtypeChoice(Choice c)
\{
    int[] menuIdx;
    foreach (kw; boxtypeNames)
    \{
        auto parts = boxtypeMenuParts(kw);
        menuIdx ~= c.add(parts[0] ~ "/" ~ parts[1], 0, null);
    \}
    return menuIdx;
\}

private int[] styleBoxMenuIdx, styleDownboxMenuIdx;

/// Position in `boxtypeNames` of the entry at menu index `mi`, or -1.
private int boxtypeAtMenuIndex(const(int)[] menuIdx, int mi)
\{
    foreach (i, m; menuIdx)
        if (m == mi) return cast(int) i;
    return -1;
\}}
  {
    private
    local
  }
decl {/// FLTK: `wp_gui_values`'s own LOAD-side field population.
///
/// In FLTK, the Values group must correctly activate/deactivate per
/// selected widget: `cb_
/// Minimum`/`cb_Maximum`/`cb_Step` each individually `activate()`/
/// `deactivate()` themselves based on whether `current_widget` is a
/// `Valuator_Node`/`Spinner_Node` (the whole group's own `cb_wp_gui_
/// values` only hides it entirely for `Flex_Node`/`Grid_Node`/`Window_
/// Node`, already ported below) -- for anything else, e.g. a plain
/// `Button`/`Box`, these fields must not show up
/// editable and silently
/// do nothing. `cb_Value` is its own separate, wider case --
/// `Valuator_Node`/`Spinner_Node`/`is_button()`, a `Button`'s own
/// checked/down state sharing the same field: e.g.
/// `settings_panel.fl`'s own `layoutPreset
/// Application`, a `type(Radio) value 1` `Button`, must show its
/// already-set default-on
/// state, not stay greyed out. `cb_Size` is its own separate case too (`Slider_Node` only,
/// matching `Fl_Slider::slider_size()`, a concept no other Valuator
/// has). Dispatches on the *live* widget's own real class (`liveTree_`)
/// rather than adding a parallel Node-level type check -- the same
/// "duck-type against the actual fl.* class" pattern `instantiate.d`'s
/// own `applyProperties()` already uses for these same type families.
private void loadValuesFields(WidgetNode wn)
\{
    auto liveW = liveTree_.widgetOf.get(wn, null);

    if (cast(Slider) liveW !is null) valuesSize.activate();
    else valuesSize.deactivate();
    double sliderSizeVal = 0;
    if (wn.hasSliderSize)
        try sliderSizeVal = to!double(wn.sliderSizeRaw); catch (ConvException) sliderSizeVal = 0;
    valuesSize.value(sliderSizeVal);

    bool isValuatorOrSpinner = cast(Valuator) liveW !is null || cast(Spinner) liveW !is null;
    if (isValuatorOrSpinner)
    \{
        valuesMinimum.activate();
        valuesMaximum.activate();
        valuesStep.activate();
    \}
    else
    \{
        valuesMinimum.deactivate();
        valuesMaximum.deactivate();
        valuesStep.deactivate();
    \}
    // `Value:` alone also applies to a plain `Button` (its checked/down
    // state) -- matches FLTK's own `cb_Value`'s LOAD branch exactly
    // (`Valuator_Node`/`is_button()`/`Spinner_Node`, all three, unlike
    // Min/Max/Step which are Valuator/Spinner-only). A
    // `Button` with `type(Radio) value 1` set (e.g. `settings_panel.fl`'s
    // own `layoutPresetApplication`) has a default-on state that this
    // field must show and edit.
    // A menu item counts as a button here too (FLTK's `Menu_Item_Node::
    // is_button()`): its value is the item's checked state
    // (`FL_MENU_VALUE`). A submenu is not (`Submenu_Node::is_button()`
    // returns 0).
    bool menuItemButton = cast(MenuItemNode) wn !is null && cast(SubmenuNode) wn is null;
    if (isValuatorOrSpinner || cast(Button) liveW !is null || menuItemButton)
        valuesValue.activate();
    else
        valuesValue.deactivate();
    double minimumVal = 0;
    if (wn.hasMinimum)
        try minimumVal = to!double(wn.minimumRaw); catch (ConvException) minimumVal = 0;
    valuesMinimum.value(minimumVal);
    double maximumVal = 1;
    if (wn.hasMaximum)
        try maximumVal = to!double(wn.maximumRaw); catch (ConvException) maximumVal = 1;
    valuesMaximum.value(maximumVal);
    double stepVal = 0;
    if (wn.hasStep)
        try stepVal = to!double(wn.stepRaw); catch (ConvException) stepVal = 0;
    valuesStep.value(stepVal);
    double valueVal = 0;
    if (wn.hasValue)
        try valueVal = to!double(wn.valueRaw); catch (ConvException) valueVal = 0;
    valuesValue.value(valueVal);
\}

/// FLTK: `labelcolor_common(c)` -- loops every selected widget now,
/// matching FLTK's own real body exactly (`for (Widget_Node *q :
/// all_selected_widgets()) \{ q->o->labelcolor(c); q->redraw(); \}`).
private void applyLabelColor(Color c)
\{
    foreach (wn; selectedWidgetNodes())
        wn.labelcolorRaw = cast(int) c;
    wLabelcolor.color(c);
    wLabelcolor.labelcolor(contrast(black, c));
    wLabelcolor.redraw();
\}

/// FLTK: `color_common(c)`.
private void applyColor(Color c)
\{
    foreach (wn; selectedWidgetNodes())
        wn.color = cast(int) c;
    wColor.color(c);
    wColor.labelcolor(contrast(black, c));
    wColor.redraw();
\}

/// FLTK: `color2_common(c)`.
private void applySelectColor(Color c)
\{
    foreach (wn; selectedWidgetNodes())
        wn.selectionColor = cast(int) c;
    wSelectcolor.color(c);
    wSelectcolor.labelcolor(contrast(black, c));
    wSelectcolor.redraw();
\}

/// FLTK: `textcolor_common(c)`.
private void applyTextColor(Color c)
\{
    foreach (wn; selectedWidgetNodes())
        wn.textcolorRaw = cast(int) c;
    wTextcolor.color(c);
    wTextcolor.labelcolor(contrast(black, c));
    wTextcolor.redraw();
\}

/// Parses `WidgetNode.shortcutRaw` back into the plain int
/// `ShortcutButton.shortcutValue()` expects (a `0x`-prefixed hex
/// literal, matching `Widget_Node::write_properties()`'s real `.fl`
/// wire format for this property).
private static int shortcutRawToInt(string raw)
\{
    import std.string : strip, startsWith;
    import std.conv : ConvException;

    auto s = raw.strip();
    if (s.length == 0) return 0;
    try
    \{
        if (s.startsWith("0x") || s.startsWith("0X"))
            return to!int(s[2 .. $], 16);
        return to!int(s);
    \}
    catch (ConvException)
        return 0;
\}}
  {
    private
    local
  }
decl {/// FLTK: the Hotspot light-button's own store branch -- walks
/// up to the containing window and clears `hotspot()` on every other
/// descendant widget (only one widget in a window can be the hotspot).
private Node topWindowOf(Node n)
\{
    Node p = n.parent;
    while (p !is null && (cast(WindowNode) p) is null)
        p = p.parent;
    return p;
\}

private void clearOtherHotspots(Node subtree, WidgetNode except)
\{
    if (subtree is null) return;
    foreach (c; subtree.children)
    \{
        if (auto cwn = cast(WidgetNode) c)
            if (cwn !is except)
                cwn.hotspotFlag = false;
        clearOtherHotspots(c, except);
    \}
\}}
  {
    private
    local
  }
decl {/// FLTK gives each of the four Size Range `Fl_Value_Input`s its own
/// independent callback (touching only its own one of `sr_min_w`/
/// `sr_min_h`/`sr_max_w`/`sr_max_h`), so this stays one shared function --
/// but each of FLTK's own 4 real callbacks writes the *same* new value to
/// every selected `Window_Node`'s own field, with no per-window read-back
/// (confirmed directly in `cb_Minimum1()`/etc, `widget_panel.cxx`), so
/// looping here for multi-apply needs no per-node value computation
/// either, just a shared value applied to every selected window.
private void onSizeRangeChanged()
\{
    int minW = cast(int) sizerangeMinW.value();
    int minH = cast(int) sizerangeMinH.value();
    int maxW = cast(int) sizerangeMaxW.value();
    int maxH = cast(int) sizerangeMaxH.value();
    foreach (winNode; selectedWindowNodes())
    \{
        winNode.sizeRangeMinW = minW;
        winNode.sizeRangeMinH = minH;
        winNode.sizeRangeMaxW = maxW;
        winNode.sizeRangeMaxH = maxH;
        winNode.hasSizeRange = true;
    \}
\}

/// FLTK: `wp_gui_margins`'s 5 `flex_margin_cb` fields (Left/Top/
/// Right/Bottom/Gap) -- `which` selects which one fired. Loops every
/// selected `Flex_Node`, matching FLTK's own `flex_margin_cb()`
/// (`widget_panel.cxx`, `for (Widget_Node *o : all_selected_widgets())
/// if (auto *q = dynamic_cast<Flex_Node*>(o)) ...`).
private void onFlexMarginChanged(int which)
\{
    double newValue = which == 0 ? marginsLeft.value()
        : which == 1 ? marginsTop.value()
        : which == 2 ? marginsRight.value()
        : which == 3 ? marginsBottom.value()
        : marginsGap.value();
    int n = cast(int) newValue;
    foreach (fn; selectedFlexNodes())
        final switch (which)
        \{
        case 0: fn.marginLeft = n; fn.hasMargin = true; break;
        case 1: fn.marginTop = n; fn.hasMargin = true; break;
        case 2: fn.marginRight = n; fn.hasMargin = true; break;
        case 3: fn.marginBottom = n; fn.hasMargin = true; break;
        case 4: fn.gap = n; fn.hasGap = true; break;
        \}
\}}
  {
    private
    local
  }
decl {/// FLTK: `Flex_Node::size(idx)` -- reads `FlexNode.fixedSizeTuples`'s
/// own `[idx, size, idx, size, ...]` encoding.
private int flexFixedSizeOf(FlexNode fn, int idx)
\{
    for (size_t i = 0; i + 1 < fn.fixedSizeTuples.length; i += 2)
        if (fn.fixedSizeTuples[i] == idx) return fn.fixedSizeTuples[i + 1];
    return 0;
\}

/// FLTK: `Fl_Flex::fixed(w, size)`'s Node-side bookkeeping -- sets
/// (or, for `size <= 0`, removes) `idx`'s own entry.
private void flexSetFixedSize(FlexNode fn, int idx, int size)
\{
    for (size_t i = 0; i + 1 < fn.fixedSizeTuples.length; i += 2)
        if (fn.fixedSizeTuples[i] == idx)
        \{
            if (size <= 0)
                fn.fixedSizeTuples = fn.fixedSizeTuples[0 .. i] ~ fn.fixedSizeTuples[i + 2 .. $];
            else
                fn.fixedSizeTuples[i + 1] = size;
            return;
        \}
    if (size > 0)
        fn.fixedSizeTuples ~= [idx, size];
\}}
  {
    private
    local
  }
decl {/// FLTK's `align_cb`, parameterized on `bit` (the button's own
/// `user_data()`) instead -- this dialect has no
/// per-`MenuItem`/per-button `user_data` payload mechanism, so each
/// Clip/Wrap/Inside button's own callback passes its bit directly. Loops
/// every selected widget now, matching FLTK's own `align_cb()`'s `for
/// (Node* o = ...) if (o->selected && o->is_widget())` loop -- each
/// node keeps its own other alignment bits, only `bit` itself changes,
/// since `x` is read from `wn.alignRaw` fresh per node.
private void onAlignBitChanged(int bit, bool set)
\{
    foreach (wn; selectedWidgetNodes())
    \{
        int x = wn.alignRaw >= 0 ? wn.alignRaw : cast(int) alignLeft;
        wn.alignRaw = set ? (x | bit) : (x & ~bit);
    \}
\}}
  {
    private
    local
  }
decl {/// FLTK: `labeltypemenu[]` (`nodes/Widget_Node.cxx`) -- 5 real
/// entries, matching `WidgetNode.labeltype`'s own raw-.fl-keyword
/// convention (same shape as `boxtype`/`downBoxtype`). The *names*
/// (`wpGuiLabeltype`'s own menu text) are literal `MenuItem \{\}`
/// children, not a `setup\{\}` snippet, so
/// `fluid.instantiate.applyMenuItems()` populates this Choice's live-
/// canvas rendering too, not just its generated D -- only the index->keyword lookup stays
/// here, in the same order the `MenuItem \{\}` children are declared in.
private immutable string[5] labeltypeKeywords =
    ["NORMAL_LABEL", "SHADOW_LABEL", "ENGRAVED_LABEL", "EMBOSSED_LABEL", "NO_LABEL"];}
  {
    private
    local
  }
Function {propagateLoadFunc(Node n)}
  {
    return_type void
    open
  }
  {
    code {currentFuncNode_ = n;
auto nd = cast(FunctionNode) n;
if (nd is null) return;
tabsWizard.value(funcTabs);
funcNameArgs.buffer().text(nd.instanceName);
funcReturnType.buffer().text(nd.returnType);
funcComment.buffer().text(nd.comment);
funcStaticChoice.value(cast(int) nd.access);
funcAccessChoice.value(cast(int) nd.access);
if (widgetInClass(nd))
  \{
    funcAccessChoice.show();
    funcStaticChoice.hide();
  \}
else
  \{
    funcStaticChoice.show();
    funcAccessChoice.hide();
  \}
funcDeclareCCheck.value(nd.declareC);
thePanel.label("Function Properties");}
      {
      }
  }
Function {propagateLoadWidget(Node n)}
  {
    return_type void
    open
  }
  {
    code {currentWidgetNode_ = n;
auto wn = cast(WidgetNode) n;
if (wn is null) return;

tabsWizard.value(widgetTabs);

// FLTK: propagate_load()'s own reparenting logic -- widgetTabGrid/
// widgetTabGridChild only sit inside widgetTabs's own children list
// (and therefore only show a tab button at all) while applicable;
// otherwise parked in widgetTabsRepo. Group.add() already detaches
// from any current parent first.
auto gridSelf = cast(GridNode) wn;
if (gridSelf !is null)
  \{
    if (widgetTabGrid.parent() !is widgetTabs)
      widgetTabs.add(widgetTabGrid);
    widgetTabGrid.load(gridSelf);
  \}
else if (widgetTabGrid.parent() is widgetTabs)
  \{
    widgetTabsRepo.add(widgetTabGrid);
  \}

if (cast(GridNode) wn.parent !is null)
  \{
    if (widgetTabGridChild.parent() !is widgetTabs)
      widgetTabs.add(widgetTabGridChild);
    widgetTabGridChild.load(wn);
  \}
else if (widgetTabGridChild.parent() is widgetTabs)
  \{
    widgetTabsRepo.add(widgetTabGridChild);
  \}

wpGuiLabel.value(wn.label);

int ltIdx = cast(int) labeltypeKeywords[].countUntil(wn.labeltype);
if (ltIdx >= 0) wpGuiLabeltype.value(ltIdx);

widgetImageInput.value(wn.imageFilename);
widgetDeimageInput.value(wn.deimageFilename);

int align_ = wn.alignRaw >= 0 ? wn.alignRaw : cast(int) alignLeft;
alignClipBtn.value((align_ & alignClip) != 0);
alignWrapBtn.value((align_ & alignWrap) != 0);
alignInsideBtn.value((align_ & alignInside) != 0);
int posIdx = cast(int) alignPositionChoiceValues[].countUntil(align_ & alignPositionMask);
if (posIdx >= 0) wpGuiAlignPosChoice.value(posIdx);
int imgIdx = cast(int) alignImageChoiceValues[].countUntil(align_ & alignImageMask);
if (imgIdx >= 0) wpGuiAlignImageChoice.value(imgIdx);

auto wcn = cast(WidgetClassNode) wn;
if (wcn !is null)
  \{
    widgetChildrenChoice.value(wcn.wcRelative);
    widgetChildrenChoice.show();
  \}
else
  \{
    widgetChildrenChoice.hide();
  \}

auto winNode = cast(WindowNode) wn;
auto flexNode = cast(FlexNode) wn;
auto gridNode = cast(GridNode) wn;

auto parentFlex = cast(FlexNode) wn.parent;
if (parentFlex !is null)
  \{
    wpGuiPosition.hide();
    wpGuiFlexp.show();
    int idx = cast(int) parentFlex.children.countUntil(wn);
    int fixedSize = flexFixedSizeOf(parentFlex, idx);
    widgetFlexFixed.value(fixedSize > 0);
    widgetFlexSize.value(fixedSize > 0 ? fixedSize : (parentFlex.typeWord == "VERTICAL" ? wn.h : wn.w));
  \}
else
  \{
    wpGuiPosition.show();
    wpGuiFlexp.hide();
    widgetXInput.value(to!string(wn.x));
    widgetYInput.value(to!string(wn.y));
    widgetWInput.value(to!string(wn.w));
    widgetHInput.value(to!string(wn.h));
  \}

if (winNode is null && flexNode is null && gridNode is null)
  \{
    wpGuiValues.show();
    loadValuesFields(wn);
  \}
else
  \{
    wpGuiValues.hide();
  \}

if (flexNode !is null)
  \{
    wpGuiMargins.show();
    marginsLeft.value(flexNode.marginLeft);
    marginsTop.value(flexNode.marginTop);
    marginsRight.value(flexNode.marginRight);
    marginsBottom.value(flexNode.marginBottom);
    marginsGap.value(flexNode.gap);
  \}
else
  \{
    wpGuiMargins.hide();
  \}

if (winNode !is null)
  \{
    wpGuiSizerange.show();
    sizerangeMinW.value(winNode.sizeRangeMinW);
    sizerangeMinH.value(winNode.sizeRangeMinH);
    sizerangeMaxW.value(winNode.sizeRangeMaxW);
    sizerangeMaxH.value(winNode.sizeRangeMaxH);

    wpGuiXclass.show();
    xclassInput.value(winNode.xclass);
    xclassBorder.value(!winNode.noBorder_);
    xclassModal.value(winNode.modal_);
    xclassNonmodal.value(winNode.nonModal_);
  \}
else
  \{
    wpGuiSizerange.hide();
    wpGuiXclass.hide();
  \}

// A shortcut only means something on the 4 widget kinds that actually
// have a `shortcut()` -- matches FLTK's own `wp_gui_shortcut` LOAD
// callback exactly (`is_button()`/`Input_Node`/`Value_Input_Node`/
// `Text_Display_Node`, `widget_panel.fl`'s own `Fl_Shortcut_Button`
// callback in real FLTK), which hides both the button and its label
// group for anything else -- e.g. a `Box`/`Group`/project-tree entry
// must not show this field editable-looking but with no
// effect. Dispatches on the *live* widget, same pattern
// `loadValuesFields()` already uses for Slider/Valuator-only fields.
auto shortcutLiveW = liveTree_.widgetOf.get(wn, null);
auto mi0 = cast(MenuItemNode) wn;
bool hasShortcutField = (mi0 !is null && cast(SubmenuNode) mi0 is null)
    || cast(Button) shortcutLiveW !is null
    || cast(Input_) shortcutLiveW !is null
    || cast(ValueInput) shortcutLiveW !is null
    || cast(TextDisplay) shortcutLiveW !is null;
if (hasShortcutField)
  \{
    wpGuiShortcutGroup.show();
    wpGuiShortcut.shortcutValue(cast(uint) shortcutRawToInt(wn.shortcutRaw));
  \}
else
  \{
    wpGuiShortcutGroup.hide();
  \}

auto mi = cast(MenuItemNode) wn;
// FLTK's own cb_Resizable/cb_Hotspot LOAD branches both deactivate
// their control on `numselected > 1` -- neither can meaningfully
// apply to more than one widget's own single "is *this* the resizable
// child" or "is *this* the hotspot" flag (both are dual-purpose:
// Resizable is real Group-relative state, Hotspot's own store branch
// walks the whole window clearing every *other* widget's flag). This
// port's own store-side callbacks already stayed single-target for
// exactly that reason -- see the "---- widget_tabs ----" comment
// block; wiring the matching LOAD-side graying here so the control
// doesn't look falsely editable-for-everyone during a multi-selection.
int numWidgetsSelected = cast(int) selectedWidgetNodes().length;
if (mi !is null)
  \{
    attrResizable.hide();
    attrHeadline.show();
    attrHeadline.value(mi.headline_);
  \}
else
  \{
    attrHeadline.hide();
    attrResizable.show();
    attrResizable.value(wn.resizableFlag);
    if (numWidgetsSelected > 1) attrResizable.deactivate();
    else attrResizable.activate();
  \}
attrVisible.value(!wn.hidden);
attrActive.value(!wn.deactivated);
// FLTK's own cb_Hotspot returns immediately after deactivating on
// numselected > 1, leaving the label/value showing whatever they last
// did rather than resetting them -- replicated faithfully, not
// "fixed" to always redisplay the primary widget's own state.
if (numWidgetsSelected > 1)
  \{
    attrHotspot.deactivate();
  \}
else
  \{
    attrHotspot.label(mi !is null ? "divider" : "Hotspot");
    attrHotspot.value(wn.hotspotFlag);
    attrHotspot.activate();
  \}

wpGuiTooltip.value(wn.tooltip);

// ---- Style tab ----
bool isMenuItem = mi !is null;
int labelfontIdx = wn.labelfont;
if (labelfontIdx < 0 || labelfontIdx > 15) labelfontIdx = 0;
styleLabelFont.value(labelfontIdx);
styleLabelSize.value(wn.labelsize > 0 ? wn.labelsize : 14);
\{
  Color c = wn.labelcolorRaw >= 0 ? cast(Color) wn.labelcolorRaw : black;
  wLabelcolor.color(c);
  wLabelcolor.labelcolor(contrast(black, c));
\}

if (isMenuItem) styleBox.deactivate(); else styleBox.activate();
int boxIdx = wn.hasBoxtype ? cast(int) boxtypeNames.countUntil(wn.boxtype) : -1;
if (boxIdx >= 0) styleBox.value(styleBoxMenuIdx[boxIdx]);
\{
  Color c = wn.color >= 0 ? cast(Color) wn.color : backgroundColor;
  wColor.color(c);
  wColor.labelcolor(contrast(black, c));
\}

int downBoxIdx = wn.hasDownBoxtype ? cast(int) boxtypeNames.countUntil(wn.downBoxtype) : -1;
if (downBoxIdx >= 0) styleDownbox.value(styleDownboxMenuIdx[downBoxIdx]);
\{
  Color c = wn.selectionColor >= 0 ? cast(Color) wn.selectionColor : selectionColor;
  wSelectcolor.color(c);
  wSelectcolor.labelcolor(contrast(black, c));
\}

styleTextFont.value(wn.textfont >= 0 && wn.textfont <= 15 ? wn.textfont : 0);
styleTextSize.value(wn.textsize > 0 ? wn.textsize : 14);
\{
  Color c = wn.textcolorRaw >= 0 ? cast(Color) wn.textcolorRaw : black;
  wTextcolor.color(c);
  wTextcolor.labelcolor(contrast(black, c));
\}

marginHorizontal.value(wn.hLabelMargin >= 0 ? wn.hLabelMargin : 0);
marginVertical.value(wn.vLabelMargin >= 0 ? wn.vLabelMargin : 0);
marginImageGap.value(wn.imageSpacing >= 0 ? wn.imageSpacing : 0);

auto liveForGating = liveTree_.widgetOf.get(wn, null);
if (isMenuItem || cast(Button) liveForGating is null)
  \{
    styleCompact.hide();
  \}
else
  \{
    styleCompact.show();
    styleCompact.value(wn.compactRaw == "1");
  \}

// ---- C++ tab ----
cppSubclassInput.value(wn.classOverride);
// Subtype choice: the kind's own table, the item the node's `type` names
// (or the kind's default) selected. Kinds without a table show a single
// inactive "Normal".
if (auto table = subtypesFor(wn.typeName))
  \{
    subtypeItems_ = null;
    foreach (item; table.items)
      subtypeItems_ ~= MenuItem(item.label);
    subtypeItems_ ~= MenuItem(null);
    cppSubtypeChoice.menu(subtypeItems_);
    cppSubtypeChoice.value(cast(int) subtypeIndex(wn, table));
    cppSubtypeChoice.activate();
  \}
else
  \{
    subtypeItems_ = [MenuItem("Normal"), MenuItem(null)];
    cppSubtypeChoice.menu(subtypeItems_);
    cppSubtypeChoice.value(0);
    cppSubtypeChoice.deactivate();
  \}
cppSubtypeChoice.redraw();
// FLTK's own cb_10 (the Name field) hides itself entirely once more
// than one widget is selected, rather than merely deactivating like
// Resizable/Hotspot above -- a name is unique per widget, so there is
// no single value to display, let alone edit, across a multi-
// selection. Its own LOAD branch also drives the whole panel's title
// bar ("Widget Properties (%d widgets)" vs. "<title> Properties"),
// replicated here too rather than leaving the title stuck on
// whichever widget happened to be primary.
if (numWidgetsSelected == 1)
  \{
    cppNameInput.value(wn.instanceName);
    cppNameInput.show();
    thePanel.label(wn.typeName.length ? wn.typeName ~ " Properties" : "Widget Properties");
  \}
else
  \{
    cppNameInput.hide();
    thePanel.label(format("Widget Properties (%d widgets)", numWidgetsSelected));
  \}

// Inside a class the widget is a field with a protection attribute;
// outside one it is a module-level variable, private or not.
cppAccessChoice.value(cast(int) wn.access);
cppScopeChoice.value(wn.access == Access.private_ ? 0 : 1);
if (widgetInClass(wn))
  \{
    cppAccessChoice.show();
    cppScopeChoice.hide();
  \}
else
  \{
    cppAccessChoice.hide();
    cppScopeChoice.show();
  \}

wComment.buffer().text(wn.comment);
codeChoice0.labelfont(wn.comment.length ? helveticaBoldItalic : helvetica);
codeChoice0.redraw();

vCodeInput2.buffer().text(wn.setupCode);
codeChoice3.labelfont(wn.setupCode.length ? helveticaBoldItalic : helvetica);
codeChoice3.redraw();

wCallback.buffer().text(wn.callback);
codeChoice5.labelfont(wn.callback.length ? helveticaBoldItalic : helvetica);
codeChoice5.redraw();
userDataInput.value(wn.userData);

// FLTK's own "When" Fl_Menu_Button LOAD branch -- deactivated for a
// Menu_Item_Node selection with an early return (FLTK doesn't even
// touch w_when_box's label in that case, so it's left showing whatever
// it last did -- replicated faithfully here too, not "fixed" to
// blank). Reads the *live* widget's own when() first (matching FLTK's
// own current_widget->o->when(), which already reflects each widget
// class's own real default correctly); falls back to the persisted
// whenRaw when no live widget exists yet.
if (isMenuItem)
  \{
    userDataWhen.deactivate();
  \}
else
  \{
    userDataWhen.activate();
    int whenN = 0;
    auto liveW = liveTree_.widgetOf.get(wn, null);
    if (liveW !is null) whenN = cast(int) liveW.when();
    else if (wn.whenRaw >= 0) whenN = wn.whenRaw;
    setWhenMenu(whenN);
    wWhenBox.label(whenSymbolName(whenN));
  \}

// ---- Availability gating (FLTK: each control's own LOAD branch) ----
// A control that means nothing for the selected node is greyed out (or
// hidden, above) rather than left looking editable.
\{
  bool isWindow = winNode !is null;
  // FLTK's `is_true_widget()`: false only for menu items.
  bool trueWidget = !isMenuItem;
  void gate(Widget w, bool on) \{ if (on) w.activate(); else w.deactivate(); \}

  gate(widgetImageInput, !isWindow);
  gate(widgetImageBrowse, !isWindow);
  gate(widgetDeimageInput, !isWindow);
  gate(widgetDeimageBrowse, !isWindow);

  // FLTK's `align_cb()`/`align_position_cb()`/`align_text_image_cb()`:
  // a menu item has no label alignment of its own.
  gate(alignClipBtn, !isMenuItem);
  gate(alignWrapBtn, !isMenuItem);
  gate(alignInsideBtn, !isMenuItem);
  gate(wpGuiAlignPosChoice, !isMenuItem);
  gate(wpGuiAlignImageChoice, !isMenuItem);

  gate(widgetXInput, trueWidget);
  gate(widgetYInput, trueWidget);
  gate(widgetWInput, trueWidget);
  gate(widgetHInput, trueWidget);

  gate(attrVisible, !isWindow);
  gate(attrActive, !isWindow);

  gate(cppSubclassInput, !isMenuItem);

  gate(wColor, !isMenuItem);
  gate(wColorMenu, !isMenuItem);
  gate(wSelectcolor, !isMenuItem);
  gate(wSelectcolorMenu, !isMenuItem);

  // Down Box: FLTK's `Button_Node` (every button, and every menu item,
  // since `Menu_Item_Node` derives from it), `Input_Choice_Node` and
  // `Menu_Manager_Node`.
  gate(styleDownbox, isMenuItem || cast(Button) liveForGating !is null
      || cast(InputChoice) liveForGating !is null
      || cast(Menu_) liveForGating !is null);

  bool hasText = widgetHasTextStuff(liveForGating);
  gate(styleTextFont, hasText);
  gate(styleTextSize, hasText);
  gate(wTextcolor, hasText);
  gate(wTextcolorMenu, hasText);

  gate(marginHorizontal, trueWidget);
  gate(marginVertical, trueWidget);
  gate(marginImageGap, trueWidget);
\}}
      {
      }
  }
decl {/// FLTK: `Widget_Node::textstuff()` returns non-zero (the widget has a
/// text font/size/color of its own, separate from its label) only for
/// the node kinds overriding it: inputs, text displays, value inputs/
/// outputs/sliders, spinners, counters, browsers, help views, terminals,
/// input choices and menu widgets.
private bool widgetHasTextStuff(Widget w)
\{
    return cast(Input_) w !is null
        || cast(TextDisplay) w !is null
        || cast(ValueInput) w !is null
        || cast(ValueOutput) w !is null
        || cast(ValueSlider) w !is null
        || cast(Spinner) w !is null
        || cast(Counter) w !is null
        || cast(Browser_) w !is null
        || cast(HelpView) w !is null
        || cast(Terminal) w !is null
        || cast(InputChoice) w !is null
        || cast(Menu_) w !is null;
\}}
  {
    private
    local
  }
decl {/// FLTK's own `whenmenu[]` (`Widget_Node.cxx`) is a single
/// Fl_Menu_Button popup mixing 5 individually-toggleable bits
/// (Changed/Not Changed/Release/Enter Key/Closed, `menuToggle`) with 4
/// non-toggle presets that set the whole value at once (Never/Release
/// Always/Enter Key Always/Enter Key Changed) -- FLTK tells a preset
/// apart from a toggle pick via `mvalue()->argument()` (each preset's
/// own void*-cast numeric payload). This port's MenuItem has no such
/// per-item payload slot at all (see CONVENTIONS.md's "callbacks are D
/// delegates" note), so `onUserDataWhenChanged()` uses pointer identity
/// against this held array instead -- the direct D-shaped equivalent,
/// not a design compromise. `menu(MenuItem[])` retains the array by
/// reference (see fl.menu_.d's own doc comment), so later .set()/
/// .clear() calls on it are reflected in the live popup automatically.
private MenuItem[10] whenMenuItems_;

/// FLTK's own `set_whenmenu(int n)` (`widget_panel_callbacks.cxx`) --
/// checks/unchecks the 5 toggle items in `whenMenuItems_` to match bits
/// in `n`, leaving the 4 preset items untouched (they're not toggles,
/// so FLTK never checks/unchecks them either).
private void setWhenMenu(int n)
\{
  if (n & whenChanged) whenMenuItems_[0].set(); else whenMenuItems_[0].clear();
  if (n & whenNotChanged) whenMenuItems_[1].set(); else whenMenuItems_[1].clear();
  if (n & whenRelease) whenMenuItems_[2].set(); else whenMenuItems_[2].clear();
  if (n & whenEnterKey) whenMenuItems_[3].set(); else whenMenuItems_[3].clear();
  if (n & whenClosed) whenMenuItems_[4].set(); else whenMenuItems_[4].clear();
\}

/// FLTK's own `when_symbol_name(int n)` (`Widget_Node.cxx`) -- same
/// table/special-case structure (an exact-16 match prints `whenClosed`
/// alone rather than falling through to `table[16&15=0]` = `whenNever`
/// plus the `| whenClosed` suffix every other `whenClosed`-combined
/// value gets), but displaying fldtk's own bare D constant spelling
/// (`whenChanged`, not `FL_WHEN_CHANGED`) -- this label exists
/// specifically to show a Fluid user which `when()` constant(s) the
/// current selection corresponds to, so it should teach the D
/// vocabulary a Fluid-generated program actually uses, matching the
/// same standing rule CONVENTIONS.md's convention apply to the demo/test
/// samples (`source/test/boxtype.d` etc.).
private string whenSymbolName(int n)
\{
  static immutable string[16] table = [
    "whenNever", "whenChanged", "whenNotChanged",
    "whenChanged | whenNotChanged", "whenRelease",
    "whenChanged | whenRelease", "whenReleaseAlways",
    "whenChanged | whenReleaseAlways", "whenEnterKey",
    "whenChanged | whenEnterKey", "whenEnterKeyAlways",
    "whenEnterKeyChanged", "whenRelease | whenEnterKey",
    "whenRelease | whenChanged | whenEnterKey",
    "whenRelease | whenEnterKeyAlways",
    "whenRelease | whenEnterKeyChanged",
  ];
  if (n == whenClosed) return "whenClosed";
  string sym = table[n & 15];
  if (n & whenClosed) sym ~= " | whenClosed";
  return sym;
\}

/// FLTK's own "When" Fl_Menu_Button store branch. Picking one of the 4
/// non-toggle presets sets the whole value directly (identified by
/// pointer identity against `whenMenuItems_[5..8]`, see that field's
/// own doc comment); picking one of the 5 toggles instead recomputes
/// `n` by OR-ing together every currently-checked toggle's own bit.
/// Loops every selected widget now, matching FLTK's own `cb_When()`
/// (`widget_panel.cxx`, `for (Widget_Node *q : all_selected_widgets())
/// q->o->when(n);`) -- the same `n` is written to every selected node,
/// no per-node read-back, matching FLTK's own real shape exactly.
private void onUserDataWhenChanged()
\{
  int n = 0;
  auto picked = userDataWhen.mvalue();
  if (picked !is null && (picked.flags & menuToggle) == 0)
  \{
    if (picked is &whenMenuItems_[5]) n = whenNever;
    else if (picked is &whenMenuItems_[6]) n = whenReleaseAlways;
    else if (picked is &whenMenuItems_[7]) n = whenEnterKeyAlways;
    else if (picked is &whenMenuItems_[8]) n = whenEnterKeyChanged;
    setWhenMenu(n);
  \}
  else
  \{
    if (whenMenuItems_[0].value()) n |= whenChanged;
    if (whenMenuItems_[1].value()) n |= whenNotChanged;
    if (whenMenuItems_[2].value()) n |= whenRelease;
    if (whenMenuItems_[3].value()) n |= whenEnterKey;
    if (whenMenuItems_[4].value()) n |= whenClosed;
  \}
  wWhenBox.label(whenSymbolName(n));
  foreach (wn; selectedWidgetNodes())
    wn.whenRaw = n;
\}}
  {
    private
    local
  }
