                              }
                            Choice cppSubtypeChoice
                              {
                                callback {auto primary = cast(WidgetNode) currentWidgetNode_;
if (primary is null) return;
auto table = subtypesFor(primary.typeName);
if (table is null || o.value() < 0 || o.value() >= cast(int) table.items.length) return;
auto chosen = table.items[o.value()];
// Applies to every selected widget of the same kind, like FLTK's
// `q->subtypes() == m` test.
foreach (wn; selectedWidgetNodes())
  \{
    if (subtypesFor(wn.typeName) !is table) continue;
    setSubtype(wn, table, o.value());
    // Only a `type()` value changes the live canvas widget; a menu item's
    // kind changes the menu it sits in, and a window's or menu bar's class
    // shows only in the generated code.
    if (table.storage == SubtypeStorage.typeWord)
      \{
        if (auto liveW = liveTree_.widgetOf.get(wn, null))
          changeLiveSubtype(wn, liveW, chosen.value);
      \}
    else if (table.storage == SubtypeStorage.menuItemKind)
      refreshLiveMenuOf(wn);
  \}}
                                xywh {267 40 138 20}
                                box THIN_UP_BOX
                                down_box BORDER_BOX
                                labelsize 11
                                textsize 11
                                tooltip {The widget subtype.}
                              }
