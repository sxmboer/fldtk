  {
    return_type void
    open
  }
  {
    code {// See this file's own comment just above -- the real implementation
// lives in gui_main.d, assigned externally (this body is unreachable).}
      {
      }
  }
Function {overlayCb(Widget o)}
  {
    return_type void
    open
  }
  {
