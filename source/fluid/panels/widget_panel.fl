decl {/// FLTK: `Fluid.proj.tree.all_selected_widgets()` -- every currently
/// selected node that derives from `WidgetNode`, in selection order. This
/// is the real multi-apply set most of `widget_tabs`'s field callbacks
/// loop over now -- see this file's own "---- widget_tabs ----" comment
/// block for which fields do (most) and don't (Name, Border, Modal,
/// Nonmodal, Resizable, Hotspot -- each confirmed single-target in FLTK's
/// own real `widget_panel.cxx`/`widget_panel_callbacks.cxx`, not merely
/// unconverted here).
private WidgetNode[] selectedWidgetNodes()
\{
    WidgetNode[] result;
    foreach (n; selectedNodes_)
        if (auto wn = cast(WidgetNode) n) result ~= wn;
    return result;
\}

/// Whether `n` sits inside a class or widget class -- FLTK's
/// `Node::is_in_class()`. Decides which access choice the Name group shows.
private bool widgetInClass(Node n)
\{
    for (auto p = n.parent; p !is null; p = p.parent)
        if (cast(ClassNode) p || cast(WidgetClassNode) p) return true;
    return false;
\}

/// The Subtype choice's menu items; `menu(MenuItem[])` keeps a reference to
/// the array, so it must outlive the choice's current menu.
private MenuItem[] subtypeItems_;

/// Rebuilds the live menu that the menu item node `n` belongs to, after a
/// change to the item that the menu displays.
private void refreshLiveMenuOf(Node n)
\{
    for (auto p = n; p !is null; p = p.parent)
        if (auto owner = cast(MenuOwnerNode) p)
        \{
            if (auto w = liveTree_.widgetOf.get(owner, null))
                applyMenuItems(owner, w, true);
            return;
        \}
\}

/// Copies the live canvas geometry of every widget below `n` into the node
/// model. FLTK reads a node's geometry straight from its widget, so a
/// change made to the widgets alone is already in the model there.
private void syncGeometryFromLive(Node n)
\{
    foreach (c; n.children)
    \{
        if (auto cw = cast(WidgetNode) c)
            if (auto lw = liveTree_.widgetOf.get(cw, null))
            geometryFromLive(cw, lw);
        syncGeometryFromLive(c);
    \}
\}

/// Sets the live canvas widget's `type()`. A Flex first rescales its
/// children to keep their proportions when its direction flips, then lays
/// out again -- FLTK's `Flex_Node::change_subtype_to()` -- and the
/// resulting sizes are written back to the child nodes.
private void changeLiveSubtype(WidgetNode wn, Widget liveW, ubyte value)
\{
    auto flex = cast(Flex) liveW;
    if (flex !is null && flex.type() != value && flex.children() > 0)
    \{
        int nc = flex.children();
        int dw = boxDw(flex.box());
        int dh = boxDh(flex.box());
        int lm, tm, rm, bm;
        flex.margin(&lm, &tm, &rm, &bm);
        int gap = flex.gap();
        int fw = flex.w() - dw - lm - rm - nc * gap;
        if (fw <= nc) fw = nc; // avoid division by zero
        int fh = flex.h() - dh - tm - bm - nc * gap;
        if (fh <= nc) fh = nc;
        if (flex.type() == flexHorizontal && value == flexVertical)
        \{
            float scl = cast(float) fh / cast(float) fw;
            foreach (i; 0 .. nc)
            \{
                auto c = flex.child(i);
                c.size(flex.w(), cast(int) (c.w() * scl));
            \}
        \}
        else if (flex.type() == flexVertical && value == flexHorizontal)
        \{
            float scl = cast(float) fw / cast(float) fh;
            foreach (i; 0 .. nc)
            \{
                auto c = flex.child(i);
                c.size(cast(int) (c.h() * scl), flex.h());
            \}
        \}
    \}
    liveW.type(value);
    if (flex !is null)
    \{
        flex.layout();
        syncGeometryFromLive(wn);
    \}
    liveW.redraw();
\}

/// The `WindowNode`-only subset of `selectedWidgetNodes()` -- FLTK's own
/// per-field `dynamic_cast<Window_Node*>(q)` guard inside its own
/// `all_selected_widgets()` loops (Size Range, X Class).
private WindowNode[] selectedWindowNodes()
\{
    WindowNode[] result;
    foreach (n; selectedNodes_)
        if (auto wn = cast(WindowNode) n) result ~= wn;
    return result;
\}

/// The `FlexNode`-only subset -- FLTK's own `dynamic_cast<Flex_Node*>(o)`
/// guard inside `flex_margin_cb()`'s own `all_selected_widgets()` loop
/// (`widget_panel.cxx`, backing the Flex "Margins:"/"Gap:" group).
private FlexNode[] selectedFlexNodes()
\{
    FlexNode[] result;
    foreach (n; selectedNodes_)
        if (auto fn = cast(FlexNode) n) result ~= fn;
    return result;
\}

/// The `WidgetClassNode`-only subset -- FLTK's own
/// `dynamic_cast<Widget_Class_Node*>(q)` guard inside `cb_Children()`.
private WidgetClassNode[] selectedWidgetClassNodes()
\{
    WidgetClassNode[] result;
    foreach (n; selectedNodes_)
        if (auto wcn = cast(WidgetClassNode) n) result ~= wcn;
    return result;
\}

/// The `MenuItemNode`-only subset -- FLTK's own
/// `dynamic_cast<Menu_Item_Node*>(q)` guard inside `cb_Headline()`.
private MenuItemNode[] selectedMenuItemNodes()
\{
    MenuItemNode[] result;
    foreach (n; selectedNodes_)
        if (auto mi = cast(MenuItemNode) n) result ~= mi;
    return result;
\}}
