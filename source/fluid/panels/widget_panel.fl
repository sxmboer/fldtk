decl {/// FLTK's own `widget_vars[]` (`panels/widget_panel_callbacks.cxx`)
/// -- the named variables available to the Position group's 4 Formula_
/// Input fields: `i` (the widget's own zero-based index in this call's
/// selection loop -- matches FLTK's own `widget_i`, a counter incremented
/// once per selected widget inside `cb_widget_x_input()`/etc's own `for
/// (Widget_Node *q : all_selected_widgets())` loop; the 4 X/Y/W/H
/// callbacks below pass their own loop index here now that they loop
/// over the whole selection instead of just one widget), `x`/`y`/`w`/`h`
/// (the widget's own live geometry), `px`/`py`/`pw`/`ph` (its parent's),
/// `sx`/`sy`/`sw`/`sh` (its previous sibling's), and `cx`/`cy`/`cw`/`ch`
/// (the bounding box of its own children) -- each read from the live
/// canvas via `liveTree_.widgetOf`, matching FLTK's own `vars_x_cb()`/etc
/// reading `((Widget_Node*)t)->o->x()` and friends. All 4 fields get the
/// same full set (FLTK's own 4 real callbacks all call `variables(widget_
/// vars, q)` identically too -- each field's own tooltip just documents
/// which subset is *relevant* to it, nothing stops a formula from
/// referencing any of them).
private FormulaVar[] positionVars(WidgetNode wn, int i)
\{
  Widget liveOf(Node n) \{ return n is null ? null : liveTree_.widgetOf.get(n, null); \}
  // A formula works in node coordinates, which differ from a widget's
  // live ones by the scroll position of any `Scroll` above it.
  int nodeX(Widget w) \{ int ox, oy; scrollOffsetAbove(w, ox, oy); return w.x() + ox; \}
  int nodeY(Widget w) \{ int ox, oy; scrollOffsetAbove(w, ox, oy); return w.y() + oy; \}

  FormulaVar[] vars;
  vars ~= FormulaVar("i", () => i);

  auto lw = liveOf(wn);
  vars ~= FormulaVar("x", () => lw !is null ? nodeX(lw) : 0);
  vars ~= FormulaVar("y", () => lw !is null ? nodeY(lw) : 0);
  vars ~= FormulaVar("w", () => lw !is null ? lw.w() : 0);
  vars ~= FormulaVar("h", () => lw !is null ? lw.h() : 0);

  auto plw = liveOf(wn.parent);
  vars ~= FormulaVar("px", () => plw !is null ? nodeX(plw) : 0);
  vars ~= FormulaVar("py", () => plw !is null ? nodeY(plw) : 0);
  vars ~= FormulaVar("pw", () => plw !is null ? plw.w() : 0);
  vars ~= FormulaVar("ph", () => plw !is null ? plw.h() : 0);

  Node sibling;
  if (wn.parent !is null)
  \{
    auto idx = wn.parent.children.countUntil(wn);
    if (idx > 0) sibling = wn.parent.children[idx - 1];
  \}
  auto slw = liveOf(sibling);
  vars ~= FormulaVar("sx", () => slw !is null ? nodeX(slw) : 0);
  vars ~= FormulaVar("sy", () => slw !is null ? nodeY(slw) : 0);
  vars ~= FormulaVar("sw", () => slw !is null ? slw.w() : 0);
  vars ~= FormulaVar("sh", () => slw !is null ? slw.h() : 0);

  int cx, cy, cr, cb;
  bool anyChild = false;
  foreach (child; wn.children)
  \{
    auto clw = liveOf(child);
    if (clw is null) continue;
    if (!anyChild)
      \{
        cx = nodeX(clw); cy = nodeY(clw); cr = nodeX(clw) + clw.w(); cb = nodeY(clw) + clw.h();
        anyChild = true;
      \}
    else
      \{
        if (nodeX(clw) < cx) cx = nodeX(clw);
        if (nodeY(clw) < cy) cy = nodeY(clw);
        if (nodeX(clw) + clw.w() > cr) cr = nodeX(clw) + clw.w();
        if (nodeY(clw) + clw.h() > cb) cb = nodeY(clw) + clw.h();
      \}
  \}
  vars ~= FormulaVar("cx", () => cx);
  vars ~= FormulaVar("cy", () => cy);
  vars ~= FormulaVar("cw", () => anyChild ? cr - cx : 0);
  vars ~= FormulaVar("ch", () => anyChild ? cb - cy : 0);

  return vars;
\}}
  {
    private
    local
  }
