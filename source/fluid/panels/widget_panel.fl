Function refreshCodeFromNode()
  {
    comment {Reloads just the code buffer's text from current()'s own
instanceName -- called by gui_main.d after its poll timer pulls in a
change an external editor made to the currently-selected node,
without disturbing the rest of the dialog's own load state. Matches
`widget_panel.d`'s (`WidgetPanelDialog`) own method of the same name.}
    return_type void
    open
  }
  {
    code {if (primaryNode_ is null) return;
if (auto con = cast(CodeNode) primaryNode_)
  \{
    codeText.buffer().text(con.instanceName);
    return;
  \}
if (cast(DataNode) primaryNode_ !is null) return; // DataNode's own Name field is separate, not a code body
if (auto den = cast(DeclNode) primaryNode_)
  \{
    declText.buffer().text(den.instanceName);
  \}}
      {
      }
  }
Function {wireEditHooks(Widget root)}
  {
    comment {Recursively wraps every leaf widget's own callback under
`root` so it fires `onBeforeEdit()` before and, after the field's own
callback (which only ever updates the *Node* model -- most fields loop
`selectedWidgetNodes()`/etc now (see the "---- widget_tabs ----"
comment block above for which fields do and don't), but never touch the
live canvas widget directly either way), a generic model->live-widget
re-sync, then
`onEdited()` -- see the "gui_main.d integration surface" comment above
for why this walks the whole tree instead of hand-threading a sync
call into each of this file's own ~100 individual field callbacks.
Called once, by gui_main.d, right after `make_widget_panel()` returns
(`wireEditHooks(widgetTabs)` -- not `thePanel` itself, so the bottom
bar's own `liveModeCb`/`overlayCb`/`okCb` stay exactly as gui_main.d
wired them, not double-wrapped).

This generic re-sync is load-bearing: without it, every field
(`wpGuiLabel`, `wpGuiLabeltype`,
`widgetXInput`/`Y`/`W`/`H`, box/color/align/when, image -- everything)
would silently regress to
Node-only edits with zero live effect. It lives here, generically, in the one place every field's callback
already funnels through, matching the earlier, now-retired
`widget_panel.d` (`WidgetPanelDialog.syncCurrentToLive()`,
`instantiate.d`'s own `applyProperties()` doc comment still describes
it).}
    return_type void
    open
  }
  {
    code {auto grp = cast(FlGroup) root;
if (grp !is null)
  \{
    foreach (i; 0 .. grp.children())
      wireEditHooks(grp.child(i));
    return;
  \}
auto orig = root.callback();
if (orig is null) return;
// A text field calls back on every keystroke; its changes form one
// undo step per editing session instead of one step per keystroke. A
// session ends when the field is left or Enter is pressed (the reason
// the callback runs with), when the selection changes (`load()`), or
// when anything else records an undo step (`gui_main.d`).
bool typing = cast(Input_) root !is null || cast(TextDisplay) root !is null
    || cast(ValueInput) root !is null;
root.callback((w) \{
  auto reason = callbackReason();
  if (typing && onBeforeTextEdit !is null)
  \{
    Object key;
    if (auto known = w in editKeys_) key = *known;
    else \{ key = new Object(); editKeys_[w] = key; \}
    onBeforeTextEdit(key);
  \}
  else if (onBeforeEdit !is null) onBeforeEdit();
  scope (exit)
    if (typing && (reason == CallbackReason.lostFocus || reason == CallbackReason.enterKey))
      editKeys_.remove(w);
  // Geometry of every selected node before the field's callback runs, to
  // tell afterwards whose box was edited.
  int[4][WidgetNode] geometryBefore;
  foreach (wn; selectedWidgetNodes())
    geometryBefore[wn] = [wn.x, wn.y, wn.w, wn.h];
  orig(w);
  // Generic model->live-widget re-sync -- see this function's own doc
  // comment above. Loops every selected `WidgetNode`, not just the
  // primary/current one, matching FLTK's own multi-select field
  // callbacks (`for (Widget_Node *q : Fluid.proj.tree.all_selected_
  // widgets()) ...`) now that the field callbacks below actually mutate
  // every selected node's own model, not just `currentWidgetNode_`'s.
  // Safe to run unconditionally even for a field that stayed single-
  // target on purpose (Name, Resizable, Hotspot, ...): `applyProperties()`
  // re-applies a node's own model to its own widget, so it's a no-op for
  // every node whose model this callback didn't actually touch.
  // `applyXywh` is `false` for a selected top-level `WindowNode`: that Node's own
  // `x`/`y` is its editor-session *screen* position, not meaningful
  // geometry to `.resize()` the live canvas window to (matches
  // `instantiate()`'s own root-window call in `instantiate.d`) -- and,
  // more importantly, `applyProperties()`'s `hidden`/`deactivated`
  // handling would otherwise call `.hide()`/`.deactivate()` on the
  // canvas window itself. `liveTree_`'s own map only ever has an entry
  // once a project is actually loaded.
  bool gridCellChanged = false;
  foreach (wn; selectedWidgetNodes())
    if (auto liveW = liveTree_.widgetOf.get(wn, null))
    \{
      applyProperties(wn, liveW, projectDir_, cast(WindowNode) wn is null || isNestedWindow(wn));
      // Resizing or moving a container moves its children live: bring
      // their nodes along.
      if (auto before = wn in geometryBefore)
        if (*before != [wn.x, wn.y, wn.w, wn.h])
          syncDescendantsFromLive(wn, liveTree_);
      // A grid and its children keep their layout in the node model: push it to the live grid.
      if (syncLayoutToLive(wn, liveTree_) && wn is currentWidgetNode_)
        gridCellChanged = true;
      Node layoutContainer = (cast(GridNode) wn !is null || cast(FlexNode) wn !is null) ? wn : wn.parent;
      if (layoutContainer !is null)
        syncLayoutFromLive(layoutContainer, liveTree_);
    \}
  // A menu item has no live widget of its own: as in FLTK's
  // `Widget_Node::redraw()`, an edit to one rebuilds the menu it sits in.
  foreach (wn; selectedWidgetNodes())
    if (cast(MenuItemNode) wn !is null)
      refreshLiveMenuOf(wn);
  if (gridCellChanged) widgetTabGridChild.load(currentWidgetNode_);
  if (onEdited !is null) onEdited();
\});}
      {
      }
  }
Function {load(Node[] selected, LiveTree live, string projectDir)}
  {
    comment {FLTK: propagate_load(), cascading LOAD through the whole
panel on every selection change. `selected` is the full
multi-selection; the "current_widget" this panel's fields load *from*
is FLTK's own convention of "the last selected node"
(`selected[$ - 1]`). Matches `widget_panel.d`'s (`WidgetPanelDialog`)
own `load()` method of the same name and signature, minus its
explicit "nothing selected" field-blanking branch -- see this
function's own trailing comment for why that's a disclosed
simplification here, not a silent one.}
    return_type void
    open
  }
  {
    code {editKeys_ = null; // a new selection ends every text editing session
selectedNodes_ = selected;
primaryNode_ = selected.length ? selected[$ - 1] : null;
liveTree_ = live;
projectDir_ = projectDir;

auto n = primaryNode_;

if (auto wn = cast(WidgetNode) n)
  \{
    propagateLoadWidget(n);
    return;
  \}
// DataNode : DeclNode, so it must be checked before the plain DeclNode
// case below -- matches FLTK: `class Data_Node : public Decl_Node`.
if (auto dn = cast(DataNode) n)
  \{
    propagateLoadData(n);
    return;
  \}
if (auto cn = cast(CommentNode) n)
  \{
    propagateLoadComment(n);
    return;
  \}
if (auto fn = cast(FunctionNode) n)
  \{
    propagateLoadFunc(n);
    return;
  \}
if (auto clsn = cast(ClassNode) n)
  \{
    propagateLoadClass(n);
    return;
  \}
// DeclBlockNode is a sibling kind, not a subclass of DeclNode --
// matches FLTK: `class DeclBlock_Node : public Node`.
if (auto dbn = cast(DeclBlockNode) n)
  \{
    propagateLoadDeclblock(n);
    return;
  \}
if (auto decln = cast(DeclNode) n)
  \{
    propagateLoadDecl(n);
    return;
  \}
if (auto cbn = cast(CodeBlockNode) n)
  \{
    propagateLoadCodeblock(n);
    return;
  \}
if (auto con = cast(CodeNode) n)
  \{
    propagateLoadCode(n);
    return;
  \}
// Nothing selected, or a node kind with no property page of its own
// (e.g. a bare root Group) -- unlike `widget_panel.d`'s own `load()`,
// there's no explicit field-blanking branch here: the dialog just
// keeps showing whichever page loaded last. A disclosed
// simplification, not a silent gap.}
      {
      }
  }
Function make_widget_panel()
  {
    comment {Create a panel that can be used with all known widgets}
    open
  }
  {
    Window thePanel
      {
        comment {Use a Double Window to avoid flickering. Named (FLTK's
own node here is anonymous) so the growing set of converted-page
propagateLoadX() functions can reach it directly (`thePanel.label(...)`)
-- FLTK's own `the_panel` global is assigned from widget_panel.h/
.cxx's own hand-written glue, deliberately not copied into this
project.}
        xywh {491 188 420 400}
        labelsize 11
        align 80
        type Double
        resizable
        hotspot
        size_range {420 400 0 0}
      }
      {
