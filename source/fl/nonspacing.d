/*
 * Ported from `FL/fl_utf8.h`'s `fl_nonspacing(unsigned int ucs)` +
 * `src/fl_utf8.cxx`'s one-line body (`return (unsigned int)
 * XUtf8IsNonSpacing(ucs);`) + the real implementation and data table it
 * delegates to, `src/xutf8/is_spacing.c` + `src/xutf8/headers/spacing.h`
 * (FLTK 1.5.0, `~/Repositories/fltk`) -- a verbatim transcription of the
 * generated range tables, not hand-derived (same "mechanically
 * generated from the real header, then spot-checked" standard
 * `fl.rgb_colors`' 490 named colors already established), generated by a
 * small script that parses the real `spacing.h` directly (not hand-typed
 * -- a first hand-transcription attempt of this same data introduced
 * real miscounts in several tables, caught only because every table
 * below carries its own `static assert` on the expected entry count;
 * mechanical generation from the source text avoids that failure mode
 * entirely), checked against the real source rather than guessed from a
 * general Unicode combining-mark table, since FLTK's own table
 * (last refreshed against an older Unicode version, per its own
 * generating script's era) doesn't necessarily match the *current*
 * Unicode standard's combining-mark set exactly -- faithfulness to
 * FLTK's actual behavior matters more here than "correctness"
 * against a newer spec FLTK itself doesn't implement.
 *
 * Given a Unicode codepoint, reports whether it's a non-spacing
 * (combining) mark -- one that's rendered stacked onto the *previous*
 * character rather than occupying its own advance width. The single
 * real consumer in this port is `fl.gdi_graphics_driver.GdiGraphicsDriver.
 * textWidth()`'s per-codepoint measurement loop (see that function's own
 * doc comment for the exact call site and why it's a narrow, single-
 * codepoint-at-a-time scope, not whole-string measurement) -- this was
 * ported here (see `PORTING.md`'s `FL/win32.H` row).
 *
 * **Not homed in `fl.text_buffer`** despite that module already porting
 * several sibling `fl_utf8.*` functions (`utf8Len`/`utf8Len1`/
 * `utf8DecodeAt`/`utf8Encode`) -- that module's own top comment
 * deliberately scopes itself to "the subset of src/fl_utf8.cxx that
 * Fl_Text_Buffer.cxx actually calls," and `nonspacing()` is not one
 * of those (`Fl_Text_Buffer.cxx` never calls it FLTK either). Kept
 * as its own small module instead, both to respect that stated scope
 * boundary and because the data is genuinely platform-independent
 * Unicode classification, not GDI/Windows-specific, even though the
 * only current consumer happens to be Windows-only (X11's own font
 * driver never had an equivalent per-codepoint gap, since it measures
 * via Xft's own combining-aware, per-string shaping instead of
 * FLTK's/this port's own manual per-codepoint sum -- see this
 * function's own single call site for the narrow case where that still
 * matters even here).
 */
module fl.nonspacing;

/**
 * Reports whether `ucs` is a non-spacing (combining) Unicode mark --
 * ported from `fl_nonspacing(unsigned int)`/`XUtf8IsNonSpacing()`.
 * Returns `0` for a spacing character (including every codepoint outside
 * the ranges FLTK's own table covers), any other value otherwise --
 * kept as FLTK's own `uint` return type (not `bool`) since the
 * nonzero value itself has no meaning beyond "truthy" (unlike, say, a
 * lookup table returning the character's own spacing-equivalent code
 * point) -- callers only ever test it for zero/nonzero, matching every
 * real call site FLTK itself has.
 */
uint nonspacing(uint ucs)
{
    if (ucs <= 0x0361)
    {
        if (ucs >= 0x0300) return ucsTable0300_[ucs - 0x0300];
        return 0;
    }
    if (ucs <= 0x0486)
    {
        if (ucs >= 0x0483) return ucsTable0483_[ucs - 0x0483];
        return 0;
    }
    if (ucs <= 0x05C4)
    {
        if (ucs >= 0x0591) return ucsTable0591_[ucs - 0x0591];
        return 0;
    }
    if (ucs <= 0x06ED)
    {
        if (ucs >= 0x064B) return ucsTable064B_[ucs - 0x064B];
        return 0;
    }
    if (ucs <= 0x0D4D)
    {
        if (ucs >= 0x0901) return ucsTable0901_[ucs - 0x0901];
        return 0;
    }
    if (ucs <= 0x0FB9)
    {
        if (ucs >= 0x0E31) return ucsTable0E31_[ucs - 0x0E31];
        return 0;
    }
    if (ucs <= 0x20E1)
    {
        if (ucs >= 0x20D0) return ucsTable20D0_[ucs - 0x20D0];
        return 0;
    }
    if (ucs <= 0x309A)
    {
        if (ucs >= 0x302A) return ucsTable302A_[ucs - 0x302A];
        return 0;
    }
    if (ucs <= 0xFB1E)
    {
        if (ucs >= 0xFB1E) return ucsTableFB1E_[ucs - 0xFB1E];
        return 0;
    }
    if (ucs <= 0xFE23)
    {
        if (ucs >= 0xFE20) return ucsTableFE20_[ucs - 0xFE20];
        return 0;
    }
    return 0;
}

