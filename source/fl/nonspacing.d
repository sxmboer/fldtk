unittest
{
    // Spot-checked against the real ranges above -- a representative
    // sample from each of the 10 blocks, both "in range and marked" and
    // "in range but a real gap" cases, plus values entirely outside
    // every range.
    assert(nonspacing(0x0041) == 0); // 'A' -- well below the first range
    assert(nonspacing(0x0301) != 0); // COMBINING ACUTE ACCENT
    assert(nonspacing(0x0362) == 0); // just past ucsTable0300_'s own end
    assert(nonspacing(0x0483) != 0); // first entry of ucsTable0483_
    assert(nonspacing(0x05A2) == 0); // a real gap inside ucsTable0591_
    assert(nonspacing(0x064B) != 0); // ARABIC FATHATAN
    assert(nonspacing(0x093C) != 0); // DEVANAGARI SIGN NUKTA
    assert(nonspacing(0x0E47) != 0); // THAI CHARACTER MAITAIKHU
    assert(nonspacing(0x20D0) != 0); // COMBINING LEFT HARPOON ABOVE
    assert(nonspacing(0x309A) != 0); // last entry of ucsTable302A_
    assert(nonspacing(0xFB1E) != 0); // the whole one-entry table
    assert(nonspacing(0xFE23) != 0); // last entry of ucsTableFE20_
    assert(nonspacing(0xFFFF) == 0); // well past every range
}
