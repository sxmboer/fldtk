    /// recommended window geometry bounds
    extern (C) void function(void* data, xdg_toplevel* xdg_toplevel, int width, int height) configure_bounds;
    /// compositor capabilities
    extern (C) void function(void* data, xdg_toplevel* xdg_toplevel, wl_array* capabilities) wm_capabilities;
}

