// ---- xdg_popup ---------------------------------------------------

/// short-lived, popup surfaces for menus
struct xdg_popup;

/// tried to grab after being mapped
enum uint XDG_POPUP_ERROR_INVALID_GRAB = 0;

/// Event handlers for `xdg_popup`, passed to `xdg_popup_add_listener()`.
struct xdg_popup_listener
{
    /// configure the popup surface
    extern (C) void function(void* data, xdg_popup* xdg_popup, int x, int y, int width, int height) configure;
    /// popup interaction is done
    extern (C) void function(void* data, xdg_popup* xdg_popup) popup_done;
    /// signal the completion of a repositioned request
    extern (C) void function(void* data, xdg_popup* xdg_popup, uint token) repositioned;
}

int xdg_popup_add_listener(xdg_popup* obj, const(xdg_popup_listener)* listener, void* data) nothrow @nogc
{
    return wl_proxy_add_listener(cast(wl_proxy*) obj, cast(void*) listener, data);
}

