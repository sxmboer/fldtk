    /// axis event
    extern (C) void function(void* data, wl_pointer* wl_pointer, uint time, uint axis, wl_fixed_t value) axis;
    /// end of a pointer event sequence
    extern (C) void function(void* data, wl_pointer* wl_pointer) frame;
    /// axis source event
    extern (C) void function(void* data, wl_pointer* wl_pointer, uint axis_source) axis_source;
    /// axis stop event
    extern (C) void function(void* data, wl_pointer* wl_pointer, uint time, uint axis) axis_stop;
    /// axis click event
    extern (C) void function(void* data, wl_pointer* wl_pointer, uint axis, int discrete) axis_discrete;
    /// axis high-resolution scroll event
