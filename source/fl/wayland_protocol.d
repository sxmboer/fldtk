/// finger on a touch surface
enum uint WL_POINTER_AXIS_SOURCE_FINGER = 1;
/// continuous coordinate space
enum uint WL_POINTER_AXIS_SOURCE_CONTINUOUS = 2;
/// a physical wheel tilt
enum uint WL_POINTER_AXIS_SOURCE_WHEEL_TILT = 3;

/// axis relative direction
/// physical motion matches axis direction
enum uint WL_POINTER_AXIS_RELATIVE_DIRECTION_IDENTICAL = 0;
/// physical motion is the inverse of the axis direction
enum uint WL_POINTER_AXIS_RELATIVE_DIRECTION_INVERTED = 1;

