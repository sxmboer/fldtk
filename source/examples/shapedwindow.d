void cb(Widget w)
{
    w.window().hide();
}

class Dragbox : Box
{
    this(int x, int y, int w, int h, string t = null)
    {
        super(x, y, w, h, t);
    }

    override int handle(Event event)
    {
        static int fromx, fromy, winx, winy;
        if (event == Event.push)
        {
            fromx = fl.eventXRoot();
            fromy = fl.eventYRoot();
            winx = window().xRoot();
            winy = window().yRoot();
            return 1;
        }
        else if (event == Event.drag)
        {
            int deltax = fl.eventXRoot() - fromx;
            int deltay = fl.eventYRoot() - fromy;
            window().position(winx + deltax, winy + deltay);
            return 1;
        }
        return super.handle(event);
    }
}

const float factor = 1.3f;

void shrink(Widget wdgt, int* minSize)
{
    Window win = wdgt.window();
    int old = win.w();
    win.size(cast(int)(old / factor), cast(int)(old / factor));
    if (win.w() <= *minSize) wdgt.deactivate();
}

void enlarge(Widget wdgt, Widget other)
{
    Window win = wdgt.window();
    int old = win.w();
    win.size(cast(int)(old * factor), cast(int)(old * factor));
    other.activate();
}

RGBImage prepareShape(int w)
{
    // draw a white circle with a hole in it on black background
    //
    // **`highRes: 1`, not the plain `ImageSurface(w, w)` this used to
    // pass**: a plain (`highRes == 0`) surface's offscreen buffer is
    // exactly `w x w` device pixels, independent of the current GUI
    // scale (`fl.image_surface`'s own doc comment) -- but fldtk's
    // `fl.draw` primitives don't know that: they read the single,
    // module-level `fl.core.currentScale()` unconditionally, regardless
    // of which surface is current. At any scale other than 100%, that
    // drew a *scaled-up* circle into this *unscaled* buffer and clipped
    // it at the buffer's own real edge -- a big circle truncated by
    // straight edges along its bottom/right, confirmed live at 150%.
    // `fl.core.transientScaleDisplay()` hit and fixed the identical
    // symptom for its own `ImageSurface` use (see that function's own
    // doc comment for the full mechanism) by forcing the live scale to
    // `1` for its drawing block -- not usable here, since that setter is
    // `package(fl)`-only and this is a sample outside the `fl` package.
    // `highRes: 1` is the public, designed-for-this mechanism instead
    // (`device.d`/`sudoku.d` already use it): it sizes the buffer at
    // `w * currentScale()` device pixels up front, matching what
    // `fl.draw`'s primitives are about to draw at anyway, so nothing
    // gets clipped. `computeShapeBitmap()` (`fl.window`) reads the
    // image's real pixel dimensions (`dataW()`/`dataH()`), not its
    // display size, so it picks up the correctly-scaled buffer
    // transparently -- no change needed on that side.
    auto surf = new ImageSurface(w, w, 1);
    SurfaceDevice.pushCurrent(surf);
    fl_color(black);
    fl_rectf(-1, -1, w + 2, w + 2);
    fl_color(white);
    fl_pie(2, 2, w - 4, w - 4, 0, 360);
    fl_color(black);
    fl_pie(cast(int)(0.7 * w), w / 2, w / 4, w / 4, 0, 360);
    RGBImage img = surf.image();
    destroy(surf);
    SurfaceDevice.popCurrent();
    return img; // return white image on black background
}

void main(string[] args)
{
    int dim = 200;
    auto win = new DoubleWindow(100, 100, dim, dim, "Testing1");
    auto img = prepareShape(dim);
    win.shape(img);
    auto box = new Dragbox(0, 0, win.w(), win.h());
    auto pxm = new Pixmap(tileXpm);
    box.bindImage(new TiledImage(pxm)); // TiledImage will be auto-released
    auto g = new FlGroup(10, 20, 80, 20);
    g.box(Boxtype.noBox);
    auto b = new Button(10, 20, 80, 20, "Close");
    b.callback((w) { cb(w); });
    g.end();
    g.resizable(null);
    g = new FlGroup(60, 70, 80, 40, "Drag me");
    g.box(Boxtype.noBox);
    g.alignment(alignTop);
    auto bs = new Button(60, 70, 80, 20, "Shrink");
    bs.callback((w) { shrink(w, &dim); });
    bs.deactivate();
    auto be = new Button(60, 90, 80, 20, "Enlarge");
    be.callback((w) { enlarge(w, bs); });
    g.end();
    g.resizable(null);
    win.end();
    win.resizable(win);
    win.show(args);
    // Test for memory leaks: this is not necessary, it's just for demonstration.
    // Memory checkers like Address Sanitizer or Valgrind would flag leaks.
    fl.run();
    destroy(win);
    destroy(pxm);
    destroy(img);
}
